<Window x:Class="CrmMes.Desktop.WithdrawalSlipDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Distinta di prelievo" Icon="Assets/logo.ico" Height="560" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="420" MinWidth="520"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <Border DockPanel.Dock="Right" x:Name="StatusPill" Style="{StaticResource Pill}" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Style="{StaticResource PillText}" />
            </Border>
            <TextBlock x:Name="CodeText" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
        </DockPanel>

        <TextBlock Grid.Row="1" x:Name="LoadingText" Text="Caricamento..." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" />

        <Grid Grid.Row="2" x:Name="HeaderInfo" Visibility="Collapsed" Margin="0,14,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                <TextBlock Text="Area" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                <TextBlock x:Name="AreaText" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                <TextBlock Text="Richiesta da" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                <TextBlock x:Name="RequestedByText" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Creata il" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                <TextBlock x:Name="CreatedAtText" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Text="Note" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                <TextBlock x:Name="NotesText" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="4">
            <ListView x:Name="ItemsList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Codice" DisplayMemberBinding="{Binding MaterialCode}" Width="130" />
                        <GridViewColumn Header="Descrizione" DisplayMemberBinding="{Binding Description}" Width="220" />
                        <GridViewColumn Header="Quantità" DisplayMemberBinding="{Binding Quantity}" Width="80" />
                        <GridViewColumn Header="Unità" DisplayMemberBinding="{Binding Unit}" Width="60" />
                        <GridViewColumn Header="Mancante" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}" Background="{Binding IsMissing, Converter={StaticResource BoolToBrush}, ConverterParameter=warning}">
                                        <TextBlock Style="{StaticResource PillText}" Text="{Binding IsMissing, Converter={StaticResource BoolToText}}" Foreground="{Binding IsMissing, Converter={StaticResource BoolToBrush}, ConverterParameter=Foreground_warning}" />
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Chiudi" Width="100" Height="36" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
