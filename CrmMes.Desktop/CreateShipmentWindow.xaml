<Window x:Class="CrmMes.Desktop.CreateShipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuova spedizione" Icon="Assets/logo.ico" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="Nuova spedizione" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,18" />

        <TextBlock Text="Direzione" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="InboundRadio" Content="In ingresso" GroupName="Direction" IsChecked="True" Checked="Direction_Changed" Margin="0,0,20,0" VerticalAlignment="Center" />
            <RadioButton x:Name="OutboundRadio" Content="In uscita" GroupName="Direction" Checked="Direction_Changed" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="Corriere" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
        <ComboBox x:Name="CarrierCombo" DisplayMemberPath="Name" Height="34" Margin="0,0,0,14" />

        <StackPanel x:Name="PurchaseOrderPanel">
            <TextBlock Text="Ordine fornitore collegato (opzionale)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
            <ComboBox x:Name="PurchaseOrderCombo" DisplayMemberPath="Code" Height="34" Margin="0,0,0,14" />
        </StackPanel>

        <StackPanel x:Name="WorkOrderPanel" Visibility="Collapsed">
            <TextBlock Text="Commessa collegata (opzionale)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
            <ComboBox x:Name="WorkOrderCombo" DisplayMemberPath="Code" Height="34" Margin="0,0,0,14" />
        </StackPanel>

        <TextBlock Text="Riferimento controparte (opzionale)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
        <TextBox x:Name="CounterpartReferenceBox" Margin="0,0,0,14" />

        <TextBlock Text="Numero tracking (opzionale)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
        <TextBox x:Name="TrackingNumberBox" Margin="0,0,0,14" />

        <TextBlock Text="Indirizzo (opzionale)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
        <TextBox x:Name="AddressBox" Margin="0,0,0,14" />

        <TextBlock Text="Data prevista (opzionale)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
        <DatePicker x:Name="ExpectedAtPicker" Margin="0,0,0,14" />

        <TextBlock Text="Note (opzionale)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
        <TextBox x:Name="NotesBox" Margin="0,0,0,14" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Annulla" Width="100" Height="36" Margin="0,0,10,0" Click="Cancel_Click" />
            <Button x:Name="CreateButton" Content="Crea spedizione" Width="150" Height="36" Click="Create_Click" />
        </StackPanel>
    </StackPanel>
</Window>
