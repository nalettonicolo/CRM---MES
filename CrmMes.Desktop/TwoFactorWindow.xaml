<Window x:Class="CrmMes.Desktop.TwoFactorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sicurezza dell'account" Icon="Assets/logo.ico" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <StackPanel Margin="28,24">
        <TextBlock Text="S I C U R E Z Z A" Style="{StaticResource MicroLabel}" />
        <TextBlock Text="Verifica in due passaggi" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock x:Name="IntroText" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,14"
                   Text="Oltre alla password, a ogni accesso serve un codice di 6 cifre generato dal tuo telefono con un'app di autenticazione (Google Authenticator, Microsoft Authenticator, Authy...). Chi ruba la password, senza il telefono non entra." />
        <Border x:Name="StatusBorder" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush0}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Text="Caricamento..." />
        </Border>

        <!-- Setup: QR code, secret as text, first code -->
        <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="1. Nell'app scegli &quot;Aggiungi account&quot; e inquadra il codice QR (oppure digita la chiave qui sotto)." />
            <Image x:Name="QrImage" Width="200" Height="200" Margin="0,10" HorizontalAlignment="Left" />
            <TextBox x:Name="SecretBox" IsReadOnly="True" FontFamily="Consolas" FontSize="14" Margin="0,0,0,12" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Text="2. Inserisci il codice di 6 cifre che compare nell'app." />
            <TextBox x:Name="SetupCodeBox" FontSize="20" MaxLength="6" Width="160" HorizontalAlignment="Left" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Recovery codes, shown once -->
        <StackPanel x:Name="RecoveryPanel" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                       Text="Codici di recupero: salvali ora, non verranno più mostrati." />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8"
                       Text="Ognuno vale una sola volta, al posto del codice dell'app se perdi il telefono. Stampali o conservali in un posto sicuro." />
            <TextBox x:Name="RecoveryBox" IsReadOnly="True" FontFamily="Consolas" FontSize="15" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="120" />
            <Button Style="{StaticResource SecondaryButton}" Content="Copia i codici" Width="140" Height="32" HorizontalAlignment="Left" Margin="0,8,0,0" Click="CopyRecovery_Click" />
        </StackPanel>

        <!-- Manage an active two-factor -->
        <StackPanel x:Name="ManagePanel" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Text="Codice dell'app (per generare nuovi codici di recupero o disattivare)" />
            <TextBox x:Name="ManageCodeBox" FontSize="18" MaxLength="12" Width="200" HorizontalAlignment="Left" Margin="0,6,0,10" />
            <StackPanel x:Name="DisablePasswordPanel">
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="Password (solo per disattivare)" />
                <PasswordBox x:Name="DisablePasswordBox" Width="260" HorizontalAlignment="Left" Margin="0,6,0,0" />
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CloseButton" Style="{StaticResource SecondaryButton}" Content="Chiudi" Width="110" Height="36" Margin="0,0,10,0" Click="Close_Click" />
            <Button x:Name="DisableButton" Style="{StaticResource SecondaryButton}" Content="Disattiva" Width="110" Height="36" Margin="0,0,10,0" Click="Disable_Click" Visibility="Collapsed" />
            <Button x:Name="NewCodesButton" Style="{StaticResource SecondaryButton}" Content="Nuovi codici di recupero" Width="190" Height="36" Margin="0,0,10,0" Click="NewCodes_Click" Visibility="Collapsed" />
            <Button x:Name="PrimaryButton" Content="Attiva" Width="150" Height="36" Click="Primary_Click" />
        </StackPanel>
    </StackPanel>
</Window>
