<Window x:Class="CrmMes.Desktop.TwoFactorCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verifica in due passaggi" Icon="Assets/logo.ico" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <StackPanel Margin="26,22">
        <TextBlock Text="Verifica in due passaggi" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,16"
                   Text="Apri l'app di autenticazione sul telefono e inserisci il codice di 6 cifre di Nicolò MES. Senza telefono puoi usare uno dei codici di recupero." />
        <TextBox x:Name="CodeBox" FontSize="22" HorizontalContentAlignment="Center" MaxLength="12" KeyDown="CodeBox_KeyDown" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Annulla" Width="100" Height="36" Margin="0,0,10,0" Click="Cancel_Click" />
            <Button x:Name="ConfirmButton" Content="Accedi" Width="120" Height="36" Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</Window>
