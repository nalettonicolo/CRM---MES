<Window x:Class="CrmMes.Desktop.SubcontractingReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rientri dal terzista" Icon="Assets/logo.ico" Width="640" Height="560" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="C O N T O   L A V O R O" Style="{StaticResource MicroLabel}" />
            <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="BalanceText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- New return: disabled once nothing is left at the subcontractor. -->
        <StackPanel DockPanel.Dock="Top" x:Name="EntryPanel" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Quantità rientrata" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
                    <TextBox x:Name="QuantityBox" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Scartata dal terzista" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
                    <TextBox x:Name="ScrapBox" Text="0" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Data rientro" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
                    <DatePicker x:Name="ReturnedAtPicker" Height="34" />
                </StackPanel>
            </Grid>
            <TextBlock Text="DDT del terzista (numero e data)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,12,0,5" />
            <TextBox x:Name="ReferenceBox" Tag="Es. 128 del 03/10/2026" />
            <TextBlock Text="Note" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,12,0,5" />
            <TextBox x:Name="NotesBox" />
            <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" x:Name="SaveButton" Content="Registra rientro" Width="150" Height="36" Click="Save_Click" />
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Chiudi" Width="100" Height="36" Click="Close_Click" />
            <TextBlock />
        </DockPanel>

        <Border Style="{StaticResource CardBorder}" Padding="4">
            <ListView x:Name="ReturnsList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Data" DisplayMemberBinding="{Binding ReturnedAt, StringFormat=dd/MM/yyyy}" Width="90" />
                        <GridViewColumn Header="Rientrata" DisplayMemberBinding="{Binding Quantity, StringFormat=0.###}" Width="80" />
                        <GridViewColumn Header="Scarto" DisplayMemberBinding="{Binding ScrapQuantity, StringFormat=0.###}" Width="70" />
                        <GridViewColumn Header="DDT terzista" DisplayMemberBinding="{Binding SupplierDocumentReference}" Width="150" />
                        <GridViewColumn Header="" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Elimina" Style="{StaticResource SecondaryButton}" Height="28" Click="DeleteReturn_Click" Tag="{Binding}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</Window>
