<Window x:Class="CrmMes.Desktop.CreateWithdrawalSlipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuova distinta di prelievo" Icon="Assets/logo.ico" Height="560" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nuova distinta di prelievo" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,18" />

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Area" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
            <ComboBox x:Name="AreaCombo" DisplayMemberPath="Name" Height="34" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Note (opzionale)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
            <TextBox x:Name="NotesBox" />
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Aggiungi riga" Width="120" Click="AddItem_Click" />
            <TextBox x:Name="ItemQuantityBox" DockPanel.Dock="Right" Width="70" Margin="0,0,10,0" Text="1" />
            <TextBox x:Name="ItemCodeBox" Margin="0,0,10,0" Tag="Codice materiale" />
        </DockPanel>

        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="4" MinHeight="140">
            <ListView x:Name="ItemsList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Codice materiale" DisplayMemberBinding="{Binding MaterialCode}" Width="240" />
                        <GridViewColumn Header="Quantità" DisplayMemberBinding="{Binding Quantity}" Width="100" />
                        <GridViewColumn Header="" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Rimuovi" Style="{StaticResource SecondaryButton}" Height="28" Click="RemoveItem_Click" Tag="{Binding}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="5" x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Annulla" Width="100" Height="36" Margin="0,0,10,0" Click="Cancel_Click" />
            <Button x:Name="CreateButton" Content="Crea distinta" Width="140" Height="36" Click="Create_Click" />
        </StackPanel>
    </Grid>
</Window>
