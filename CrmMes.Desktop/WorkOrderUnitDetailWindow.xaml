<Window x:Class="CrmMes.Desktop.WorkOrderUnitDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dettaglio unità" Icon="Assets/logo.ico" Height="600" Width="680" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="440" MinWidth="560"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="U N I T À" Style="{StaticResource MicroLabel}" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock x:Name="SerialText" Style="{StaticResource EditorialTitle}" FontSize="26" Margin="0,0,0,4" />
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="InfoText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,10" />
        <TextBlock Grid.Row="2" x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

        <TextBlock Grid.Row="3" Text="Fasi attraversate" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="4">
            <ListView x:Name="OperationsList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="#" DisplayMemberBinding="{Binding SequenceNumber}" Width="40" />
                        <GridViewColumn Header="Fase" DisplayMemberBinding="{Binding Name}" Width="200" />
                        <GridViewColumn Header="Stato" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToItalianText}}" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Foreground}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Iniziata" DisplayMemberBinding="{Binding StartedAt}" Width="130" />
                        <GridViewColumn Header="Completata" DisplayMemberBinding="{Binding CompletedAt}" Width="130" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="5" Text="Lotti materiali attribuiti" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,16,0,6" />
        <Border Grid.Row="6" Style="{StaticResource CardBorder}" Padding="4">
            <ListView x:Name="MaterialLotsList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Materiale" DisplayMemberBinding="{Binding MaterialCode}" Width="180" />
                        <GridViewColumn Header="Lotto" DisplayMemberBinding="{Binding LotNumber}" Width="220" />
                        <GridViewColumn Header="Quantità" DisplayMemberBinding="{Binding Quantity}" Width="100" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Chiudi" Width="100" Height="36" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
