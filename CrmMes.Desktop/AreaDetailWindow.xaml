<Window x:Class="CrmMes.Desktop.AreaDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CrmMes.Desktop"
        Title="Dettaglio area" Icon="Assets/logo.ico" Height="620" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="480" MinWidth="520"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="A R E A" Style="{StaticResource MicroLabel}" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock x:Name="AreaTitleText" Style="{StaticResource EditorialTitle}" FontSize="26" Margin="0,0,0,4" />
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="AreaInfoText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,4,0,16" />

        <DockPanel Grid.Row="2" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Assegna utente" Width="130" Height="30" Click="AssignUser_Click" />
            <TextBlock Text="Utenti assegnati" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </DockPanel>
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="4" Margin="0,0,0,16">
            <ListView x:Name="UsersList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Name}" Width="180" />
                        <GridViewColumn Header="Ruolo" DisplayMemberBinding="{Binding Role}" Width="110" />
                        <GridViewColumn Header="" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Rimuovi" Style="{StaticResource SecondaryButton}" Height="26" Click="RemoveUser_Click" Tag="{Binding}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="4" Text="Commesse destinate qui" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <Border Grid.Row="5" Style="{StaticResource CardBorder}" Padding="4" Margin="0,0,0,16">
            <ListView x:Name="WorkOrdersList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Codice" DisplayMemberBinding="{Binding Code}" Width="150" />
                        <GridViewColumn Header="Stato" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}" Background="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                        <TextBlock Style="{StaticResource PillText}" Text="{Binding Status, Converter={StaticResource StatusToItalianText}}" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Foreground}" />
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Scadenza" DisplayMemberBinding="{Binding DueDate}" Width="120" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="6" Text="Distinte di prelievo verso quest'area" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <Border Grid.Row="7" Style="{StaticResource CardBorder}" Padding="4">
            <ListView x:Name="WithdrawalSlipsList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Codice" DisplayMemberBinding="{Binding Code}" Width="150" />
                        <GridViewColumn Header="Stato" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}" Background="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                        <TextBlock Style="{StaticResource PillText}" Text="{Binding Status, Converter={StaticResource StatusToItalianText}}" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Foreground}" />
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Creata il" DisplayMemberBinding="{Binding CreatedAt}" Width="140" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</Window>
