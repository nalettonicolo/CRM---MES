<Window x:Class="CrmMes.Desktop.CustomerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cliente" Icon="Assets/logo.ico" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <StackPanel Margin="24">
        <TextBlock x:Name="HeaderText" Text="Nuovo cliente" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,18" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Ragione sociale" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
                <TextBox x:Name="NameBox" Margin="0,0,0,14" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Codice" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
                <TextBox x:Name="CodeBox" Margin="0,0,0,14" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Partita IVA (opzionale)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
        <TextBox x:Name="VatBox" Margin="0,0,0,14" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Email (opzionale)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
                <TextBox x:Name="EmailBox" Margin="0,0,0,14" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Telefono (opzionale)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
                <TextBox x:Name="PhoneBox" Margin="0,0,0,14" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Indirizzo (opzionale)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
        <TextBox x:Name="AddressBox" Margin="0,0,0,14" />

        <TextBlock Text="Note (opzionale)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
        <TextBox x:Name="NotesBox" Height="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,14" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Annulla" Width="100" Height="36" Margin="0,0,10,0" Click="Cancel_Click" />
            <Button x:Name="SaveButton" Content="Crea cliente" Width="140" Height="36" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
