<Window x:Class="CrmMes.Desktop.LayoutEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Layout dei moduli" Icon="Assets/logo.ico" Width="900" Height="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="720" MinHeight="420"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="L A Y O U T   D E I   M O D U L I" Style="{StaticResource MicroLabel}" />
        <TextBlock Grid.Row="1" Text="Etichetta, ordine, visibilità e obbligatorietà dei campi. Le modifiche valgono per tutti gli utenti, anche sul web."
                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Modulo" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" />
                    <ComboBox x:Name="ScreenCombo" Width="360" DisplayMemberPath="Name" SelectionChanged="ScreenCombo_SelectionChanged" />
                </StackPanel>
                <StackPanel x:Name="AccessPanel" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="Chi può modificare i layout, oltre all'Admin" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <WrapPanel x:Name="RolesPanel" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Salva autorizzazioni" Width="170" Height="32"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Click="SaveAccess_Click" />
                </StackPanel>
                <ListView x:Name="FieldsList">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Ordine" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Width="56" Text="{Binding Order, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Campo (predefinito)" DisplayMemberBinding="{Binding DefaultLabel}" Width="200" />
                            <GridViewColumn Header="Etichetta mostrata" Width="240">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Width="230" Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Visibile" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Visible, Mode=TwoWay}" IsEnabled="{Binding CanHide}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Obbligatorio" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Required, Mode=TwoWay}" IsEnabled="{Binding RequiredEditable}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Ripristina predefiniti" Width="170" Height="36" Margin="0,0,10,0" Click="Reset_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="Chiudi" Width="100" Height="36" Margin="0,0,10,0" Click="Close_Click" />
            <Button x:Name="SaveButton" Content="Salva layout" Width="140" Height="36" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
