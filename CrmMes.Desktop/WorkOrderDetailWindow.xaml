<Window x:Class="CrmMes.Desktop.WorkOrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CrmMes.Desktop"
        Title="Commessa" Icon="Assets/logo.ico" Height="640" Width="860"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="480" MinWidth="740"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <Border DockPanel.Dock="Right" x:Name="StatusPill" Style="{StaticResource Pill}" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Style="{StaticResource PillText}" />
            </Border>
            <TextBlock x:Name="CodeText" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <local:HelpIcon Margin="8,4,0,0"
                             Text="Dettaglio di una commessa di produzione. Rilascia verifica la disponibilità dei materiali della distinta base (se manca qualcosa, chiede conferma prima di procedere comunque). Pianifica assegna a ogni fase ancora aperta il giorno (o i giorni) in cui dovrebbe essere eseguita, in base alla capacità giornaliera registrata per il suo centro di lavoro — è una stima a livello di giorno, non un orario preciso. Ogni fase si avvia e si completa singolarmente; a fine fase il sistema calcola i minuti effettivi e il rapporto stimato/effettivo (performance)." />
            <TextBlock x:Name="LotNumberText" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,4,0,0" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Grid.Row="1" x:Name="LoadingText" Text="Caricamento..." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" />

        <Grid Grid.Row="2" x:Name="HeaderInfo" Visibility="Collapsed" Margin="0,14,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                <TextBlock Text="Prodotto" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                <TextBlock x:Name="ProductText" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,10">
                <TextBlock Text="Quantità" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                <TextBlock x:Name="QuantityText" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                <TextBlock Text="Scadenza" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                <TextBlock x:Name="DueDateText" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Riferimento cliente" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                <TextBlock x:Name="CustomerReferenceText" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="Creata il" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                <TextBlock x:Name="CreatedAtText" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Text="Note" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                <TextBlock x:Name="NotesText" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="4">
            <ListView x:Name="OperationsList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="#" DisplayMemberBinding="{Binding SequenceNumber}" Width="30" />
                        <GridViewColumn Header="Fase" DisplayMemberBinding="{Binding Name}" Width="150" />
                        <GridViewColumn Header="Centro di lavoro" DisplayMemberBinding="{Binding WorkCenter}" Width="130" />
                        <GridViewColumn Header="Stato" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}" Background="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                        <TextBlock Style="{StaticResource PillText}" Text="{Binding Status, Converter={StaticResource StatusToItalianText}}" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Foreground}" />
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Min. effettivi" DisplayMemberBinding="{Binding ActualMinutes, StringFormat={}{0:0.0}}" Width="90" />
                        <GridViewColumn Header="Performance" DisplayMemberBinding="{Binding PerformanceRatio, StringFormat={}{0:P0}}" Width="90" />
                        <GridViewColumn Header="Pianificato dal" DisplayMemberBinding="{Binding PlannedStartAt, StringFormat={}{0:d}}" Width="100" />
                        <GridViewColumn Header="al" DisplayMemberBinding="{Binding PlannedEndAt, StringFormat={}{0:d}}" Width="90" />
                        <GridViewColumn Header="" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Status, Converter={StaticResource OperationStatusToActionText}}"
                                            Visibility="{Binding Status, Converter={StaticResource StatusNotEqualToVisibility}, ConverterParameter=Done}"
                                            Style="{StaticResource SecondaryButton}" Height="28" Click="OperationAction_Click" Tag="{Binding}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Fermi" Style="{StaticResource SecondaryButton}" Height="28" Click="Downtimes_Click" Tag="{Binding}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="NC" Style="{StaticResource SecondaryButton}" Height="28" Click="NonConformities_Click" Tag="{Binding}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="4" x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="LabelButton" Style="{StaticResource SecondaryButton}" Content="Etichetta QR" Width="120" Height="36" Margin="0,0,10,0" Click="Label_Click" />
            <Button x:Name="UnitsButton" Style="{StaticResource SecondaryButton}" Content="Unità prodotte" Width="130" Height="36" Margin="0,0,10,0" Click="Units_Click" />
            <Button x:Name="TraceabilityButton" Style="{StaticResource SecondaryButton}" Content="Tracciabilità materiali" Width="160" Height="36" Margin="0,0,10,0" Click="Traceability_Click" />
            <Button x:Name="ScheduleButton" Style="{StaticResource SecondaryButton}" Content="Pianifica" Width="110" Height="36" Margin="0,0,10,0" Click="Schedule_Click" />
            <Button x:Name="ReleaseButton" Content="Rilascia" Width="110" Height="36" Margin="0,0,10,0" Click="Release_Click" />
            <Button x:Name="CompleteButton" Content="Completa" Width="110" Height="36" Margin="0,0,10,0" Click="Complete_Click" />
            <Button x:Name="GenerateSlipButton" Style="{StaticResource SecondaryButton}" Content="Genera distinta" Width="140" Height="36" Margin="0,0,10,0" Click="GenerateSlip_Click" />
            <Button x:Name="CancelButton" Style="{StaticResource DangerButton}" Content="Annulla commessa" Width="150" Height="36" Margin="0,0,10,0" Click="Cancel_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="Chiudi" Width="100" Height="36" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
