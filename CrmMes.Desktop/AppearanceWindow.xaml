<Window x:Class="CrmMes.Desktop.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aspetto grafico" Icon="Assets/logo.ico" Width="920" Height="740" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="A M M I N I S T R A Z I O N E" Style="{StaticResource MicroLabel}" />
            <TextBlock Text="Aspetto grafico" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Scegli una palette o regola colori, angoli e densità. Vale per tutta l'azienda (programma desktop e piattaforma web)." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Content="Annulla" Width="110" Height="36" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button x:Name="SaveButton" Content="Salva" Width="140" Height="36" Click="Save_Click" IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" Text="Caricamento..." />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="P A L E T T E" Style="{StaticResource MicroLabel}" Margin="0,0,0,8" />
                <WrapPanel x:Name="PresetsPanel" Margin="0,0,0,20" />

                <TextBlock Text="C O L O R I" Style="{StaticResource MicroLabel}" Margin="0,0,0,8" />
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush0}" BorderThickness="1" Padding="16,12" Margin="0,0,0,20">
                    <UniformGrid Columns="2" x:Name="ColorsGrid" />
                </Border>

                <TextBlock Text="F O R M A   E   C A M P I" Style="{StaticResource MicroLabel}" Margin="0,0,0,8" />
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush0}" BorderThickness="1" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,12">
                            <TextBlock Text="Raggio angoli" Margin="0,0,0,4" />
                            <DockPanel>
                                <TextBlock x:Name="RadiusValue" DockPanel.Dock="Right" Width="40" Text="0" VerticalAlignment="Center" />
                                <Slider x:Name="RadiusSlider" Minimum="0" Maximum="16" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Shape_Changed" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="Altezza campi" Margin="0,0,0,4" />
                            <DockPanel>
                                <TextBlock x:Name="HeightValue" DockPanel.Dock="Right" Width="40" Text="38" VerticalAlignment="Center" />
                                <Slider x:Name="HeightSlider" Minimum="30" Maximum="48" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Shape_Changed" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,12">
                            <TextBlock Text="Densità" Margin="0,0,0,4" />
                            <ComboBox x:Name="DensityBox" SelectionChanged="Shape_Changed">
                                <ComboBoxItem Content="Compatta" Tag="compact" />
                                <ComboBoxItem Content="Comoda" Tag="comfortable" IsSelected="True" />
                                <ComboBoxItem Content="Ariosa" Tag="airy" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="Sfondo pagina" Margin="0,0,0,4" />
                            <ComboBox x:Name="BgStyleBox" SelectionChanged="Shape_Changed">
                                <ComboBoxItem Content="Tinta unita" Tag="solid" IsSelected="True" />
                                <ComboBoxItem Content="Griglia" Tag="grid" />
                                <ComboBoxItem Content="Grain" Tag="grain" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Spessore bordo campo" Margin="0,0,0,4" />
                            <ComboBox x:Name="BorderBox" SelectionChanged="Shape_Changed">
                                <ComboBoxItem Content="1 px" Tag="1" IsSelected="True" />
                                <ComboBoxItem Content="2 px" Tag="2" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Text="Carattere" Margin="0,0,0,4" />
                            <ComboBox x:Name="FontBox" SelectionChanged="Shape_Changed">
                                <ComboBoxItem Content="Predefinito (IBM Plex Sans)" Tag="default" IsSelected="True" />
                                <ComboBoxItem Content="Segoe UI" Tag="segoe" />
                                <ComboBoxItem Content="Calibri" Tag="calibri" />
                                <ComboBoxItem Content="Georgia (con grazie)" Tag="georgia" />
                                <ComboBoxItem Content="Verdana" Tag="verdana" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
