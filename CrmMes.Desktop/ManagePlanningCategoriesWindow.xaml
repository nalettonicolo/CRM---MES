<Window x:Class="CrmMes.Desktop.ManagePlanningCategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Categorie di fase" Icon="Assets/logo.ico" Height="560" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="420" MinWidth="480"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="C A T E G O R I E   D I   F A S E" Style="{StaticResource MicroLabel}" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock Style="{StaticResource EditorialTitle}" FontSize="22" Text="Categorie di fase" Margin="0,0,0,4" />
            <TextBlock Text="Le categorie determinano cosa si può dipingere sul planning: codice, nome e colore sono liberi, non un elenco fisso." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,14" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Nuova categoria" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="NewCodeBox" Width="70" Height="32" Margin="0,0,8,0" Tag="Codice" MaxLength="6" />
                    <TextBox x:Name="NewNameBox" Width="200" Height="32" Margin="0,0,8,0" Tag="Nome fase" />
                    <ComboBox x:Name="NewColorCombo" Width="120" Height="32" Margin="0,0,8,0" />
                    <Button Content="Aggiungi" Width="90" Height="32" Click="AddCategory_Click" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="4">
            <ListView x:Name="CategoriesList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Colore" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding ColorHex}" Width="20" Height="20" CornerRadius="3" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Codice" DisplayMemberBinding="{Binding Code}" Width="70" />
                        <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Name}" Width="200" />
                        <GridViewColumn Header="Stato" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToText}, ConverterParameter=Attiva|Disattiva}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Disattiva" Style="{StaticResource SecondaryButton}" Height="26" Click="DeactivateCategory_Click" Tag="{Binding}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Chiudi" Width="100" Height="36" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
