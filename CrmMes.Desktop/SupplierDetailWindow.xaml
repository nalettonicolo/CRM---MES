<Window x:Class="CrmMes.Desktop.SupplierDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dettaglio fornitore" Icon="Assets/logo.ico" Height="640" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="480" MinWidth="560"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.2*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="F O R N I T O R E" Style="{StaticResource MicroLabel}" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock x:Name="SupplierTitleText" Style="{StaticResource EditorialTitle}" FontSize="26" Margin="0,0,0,4" />
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="SupplierInfoText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,10" />

        <DockPanel Grid.Row="2" Margin="0,0,0,16">
            <Button x:Name="OpenWebsiteButton" DockPanel.Dock="Left" Content="Apri sito fornitore ↗" Style="{StaticResource SecondaryButton}" Height="32" Width="180" Margin="0,0,10,0" Click="OpenWebsite_Click" IsEnabled="False" />
            <Button DockPanel.Dock="Left" Content="Modifica" Height="32" Width="100" Click="Edit_Click" />
        </DockPanel>

        <TextBlock Grid.Row="3" Text="Ordini d'acquisto" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="4" Margin="0,0,0,16">
            <ListView x:Name="PurchaseOrdersList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Codice" DisplayMemberBinding="{Binding Code}" Width="150" />
                        <GridViewColumn Header="Stato" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}" Background="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                        <TextBlock Style="{StaticResource PillText}" Text="{Binding Status, Converter={StaticResource StatusToItalianText}}" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Foreground}" />
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Creato il" DisplayMemberBinding="{Binding CreatedAt}" Width="150" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="5" Text="Voci di catalogo (da import o inserite a mano)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <Border Grid.Row="6" Style="{StaticResource CardBorder}" Padding="4">
            <ListView x:Name="CatalogList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Materiale" DisplayMemberBinding="{Binding MaterialCode}" Width="110" />
                        <GridViewColumn Header="Descrizione" DisplayMemberBinding="{Binding MaterialName}" Width="160" />
                        <GridViewColumn Header="Part number" DisplayMemberBinding="{Binding PartNumber}" Width="120" />
                        <GridViewColumn Header="Prezzo" DisplayMemberBinding="{Binding UnitPrice}" Width="80" />
                        <GridViewColumn Header="Lead time (gg)" DisplayMemberBinding="{Binding LeadTimeDays}" Width="100" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</Window>
