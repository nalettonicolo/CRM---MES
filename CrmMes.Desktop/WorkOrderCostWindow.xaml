<Window x:Class="CrmMes.Desktop.WorkOrderCostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Costi e margine" Icon="Assets/logo.ico" Height="760" Width="980"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="560" MinWidth="820"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,4,0,2" />
        </Style>
        <Style x:Key="TileNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="D I R E Z I O N E" Style="{StaticResource MicroLabel}" />
            <TextBlock x:Name="HeaderText" Text="Costi e margine" Style="{StaticResource EditorialTitle}" FontSize="24" />
            <TextBlock x:Name="SubHeaderText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" />
        </StackPanel>

        <!-- Summary: revenue, estimate, actual, margin -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Prezzo di vendita" Style="{StaticResource TileLabel}" />
                    <DockPanel Margin="0,6,0,0">
                        <Button x:Name="SavePriceButton" DockPanel.Dock="Right" Content="Salva" Width="70" Height="34" Margin="8,0,0,0" Click="SavePrice_Click" />
                        <TextBox x:Name="SalePriceBox" Height="34" Tag="€ imponibile" />
                    </DockPanel>
                    <TextBlock x:Name="SalePriceNote" Style="{StaticResource TileNote}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Costo stimato" Style="{StaticResource TileLabel}" />
                    <TextBlock x:Name="EstimatedText" Style="{StaticResource TileValue}" />
                    <TextBlock x:Name="EstimatedBreakdown" Style="{StaticResource TileNote}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CardBorder}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Costo reale" Style="{StaticResource TileLabel}" />
                    <TextBlock x:Name="ActualText" Style="{StaticResource TileValue}" />
                    <TextBlock x:Name="ActualBreakdown" Style="{StaticResource TileNote}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource CardBorder}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Margine reale" Style="{StaticResource TileLabel}" />
                    <TextBlock x:Name="MarginText" Style="{StaticResource TileValue}" />
                    <TextBlock x:Name="MarginNote" Style="{StaticResource TileNote}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" x:Name="WarningsBorder" Background="#FBF1E3" BorderBrush="#E8C9A0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
            <ItemsControl x:Name="WarningsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat='• {0}'}" Foreground="#7A4705" FontSize="12.5" TextWrapping="Wrap" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Grid.Row="3" Text="Materiali prelevati" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="4" Margin="0,0,0,14">
            <ListView x:Name="MaterialsList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Materiale" DisplayMemberBinding="{Binding MaterialCode}" Width="220" />
                        <GridViewColumn Header="Quantità" DisplayMemberBinding="{Binding Quantity, StringFormat=0.##}" Width="90" />
                        <GridViewColumn Header="Prezzo da" DisplayMemberBinding="{Binding PriceSource}" Width="170" />
                        <GridViewColumn Header="Senza prezzo" DisplayMemberBinding="{Binding UnpricedQuantity, StringFormat=0.##}" Width="100" />
                        <GridViewColumn Header="Costo €" DisplayMemberBinding="{Binding Cost, StringFormat=N2}" Width="120" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="5" Text="Manodopera" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <Border Grid.Row="6" Style="{StaticResource CardBorder}" Padding="4">
            <ListView x:Name="LaborList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Tipo" DisplayMemberBinding="{Binding Kind}" Width="110" />
                        <GridViewColumn Header="Descrizione" DisplayMemberBinding="{Binding Description}" Width="220" />
                        <GridViewColumn Header="Centro di lavoro" DisplayMemberBinding="{Binding WorkCenter}" Width="140" />
                        <GridViewColumn Header="Operatore" DisplayMemberBinding="{Binding Operator}" Width="130" />
                        <GridViewColumn Header="Minuti" DisplayMemberBinding="{Binding Minutes, StringFormat=0.#}" Width="70" />
                        <GridViewColumn Header="€/ora" DisplayMemberBinding="{Binding HourlyRate, StringFormat=N2}" Width="70" />
                        <GridViewColumn Header="Costo €" DisplayMemberBinding="{Binding Cost, StringFormat=N2}" Width="100" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <DockPanel Grid.Row="7" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Content="Ore lavorate" Width="120" Height="36" Margin="0,0,10,0" Click="Labor_Click" />
                <Button Style="{StaticResource SecondaryButton}" Content="Aggiorna" Width="100" Height="36" Margin="0,0,10,0" Click="Refresh_Click" />
                <Button Style="{StaticResource SecondaryButton}" Content="Chiudi" Width="100" Height="36" Click="Close_Click" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
