<Window x:Class="CrmMes.Desktop.SiteDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dettaglio sede" Icon="Assets/logo.ico" Height="560" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="420" MinWidth="500"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="S E D E" Style="{StaticResource MicroLabel}" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock x:Name="SiteTitleText" Style="{StaticResource EditorialTitle}" FontSize="26" Margin="0,0,0,4" />
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="SiteInfoText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,16" />

        <TextBlock Grid.Row="2" Text="Aree" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="4" Margin="0,0,0,16">
            <ListView x:Name="AreasList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Codice" DisplayMemberBinding="{Binding Code}" Width="140" />
                        <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Name}" Width="220" />
                        <GridViewColumn Header="Attiva" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToText}, ConverterParameter=Attiva|Inattiva}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="4" Text="Centri di lavoro" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <Border Grid.Row="5" Style="{StaticResource CardBorder}" Padding="4">
            <ListView x:Name="WorkCentersList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Codice" DisplayMemberBinding="{Binding Code}" Width="140" />
                        <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Name}" Width="220" />
                        <GridViewColumn Header="Attivo" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToText}, ConverterParameter=Attivo|Inattivo}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</Window>
