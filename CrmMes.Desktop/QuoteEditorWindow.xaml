<Window x:Class="CrmMes.Desktop.QuoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preventivo" Icon="Assets/logo.ico" Height="720" Width="980"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="560" MinWidth="820"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="V E N D I T E" Style="{StaticResource MicroLabel}" />
            <TextBlock x:Name="HeaderText" Text="Nuovo preventivo" Style="{StaticResource EditorialTitle}" FontSize="24" />
        </StackPanel>

        <!-- Header: customer, validity, notes -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Cliente" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Nuovo" Width="70" Height="34" Margin="8,0,0,0" Click="NewCustomer_Click" />
                    <ComboBox x:Name="CustomerCombo" Height="34" DisplayMemberPath="Name" />
                </DockPanel>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Valido fino al" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
                <DatePicker x:Name="ValidUntilPicker" Height="34" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Note per il cliente (opzionale)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
                <TextBox x:Name="NotesBox" Height="34" Tag="Es. consegna in 6 settimane dall'ordine, IVA esclusa" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="Righe" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

        <!-- New line strip -->
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="ProductCombo" Height="34" DisplayMemberPath="Label" SelectionChanged="ProductCombo_SelectionChanged" />
            <TextBox Grid.Column="2" x:Name="DescriptionBox" Height="34" Tag="Descrizione riga" />
            <TextBox Grid.Column="4" x:Name="QuantityBox" Height="34" Text="1" Tag="Q.tà" />
            <TextBox Grid.Column="6" x:Name="PriceBox" Height="34" Tag="Prezzo unit. €" />
            <TextBox Grid.Column="8" x:Name="DiscountBox" Height="34" Text="0" Tag="Sconto %" />
            <Button Grid.Column="10" Content="Aggiungi riga" Width="120" Height="34" Click="AddLine_Click" />
        </Grid>

        <!-- Price estimate from the bill of materials -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Ricarico sui materiali %" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,8,0" />
            <TextBox x:Name="MarkupBox" Width="60" Height="30" Text="40" />
            <Button x:Name="EstimateButton" Style="{StaticResource SecondaryButton}" Content="Stima prezzo da distinta" Width="190" Height="30" Margin="10,0,0,0" Click="Estimate_Click" IsEnabled="False" />
            <TextBlock x:Name="EstimateText" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="480" />
        </StackPanel>

        <Border Grid.Row="5" Style="{StaticResource CardBorder}" Padding="4">
            <ListView x:Name="LinesList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Prodotto" DisplayMemberBinding="{Binding ProductLabel}" Width="170" />
                        <GridViewColumn Header="Descrizione" DisplayMemberBinding="{Binding Description}" Width="260" />
                        <GridViewColumn Header="Q.tà" DisplayMemberBinding="{Binding Quantity, StringFormat=0.##}" Width="60" />
                        <GridViewColumn Header="Prezzo €" DisplayMemberBinding="{Binding UnitPrice, StringFormat=N2}" Width="100" />
                        <GridViewColumn Header="Sconto %" DisplayMemberBinding="{Binding DiscountPercent, StringFormat=0.##}" Width="70" />
                        <GridViewColumn Header="Totale €" DisplayMemberBinding="{Binding LineTotal, StringFormat=N2}" Width="110" />
                        <GridViewColumn Header="" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Rimuovi" Style="{StaticResource SecondaryButton}" Height="28" Click="RemoveLine_Click" Tag="{Binding}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <DockPanel Grid.Row="6" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Content="Annulla" Width="100" Height="36" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button x:Name="SaveButton" Content="Salva preventivo" Width="160" Height="36" Click="Save_Click" />
            </StackPanel>
            <TextBlock x:Name="TotalText" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Text="Totale 0,00 €" />
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="20,0,20,0" />
        </DockPanel>
    </Grid>
</Window>
