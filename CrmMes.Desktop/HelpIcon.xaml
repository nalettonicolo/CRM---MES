<UserControl x:Class="CrmMes.Desktop.HelpIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" VerticalAlignment="Center" Focusable="False">
    <Button x:Name="IconButton" Width="17" Height="17" Padding="0" Cursor="Help"
            Background="Transparent" BorderThickness="0"
            Click="IconButton_Click"
            ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="90000"
            ToolTip="{Binding Text, ElementName=Root}">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Grid>
                    <Ellipse x:Name="Ring" Fill="Transparent" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1" />
                    <TextBlock x:Name="Mark" Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource PrimaryBrush}" />
                        <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</UserControl>
