<UserControl x:Class="CrmMes.Desktop.HelpIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" VerticalAlignment="Center" Focusable="False">
    <Button x:Name="IconButton" Width="17" Height="17" Padding="0" Cursor="Help"
            Background="Transparent" BorderThickness="0"
            Click="IconButton_Click"
            ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="90000"
            ToolTip="{Binding Text, ElementName=Root}">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Grid>
                    <Ellipse Fill="#E2E8F0" Stroke="#94A3B8" StrokeThickness="1" />
                    <TextBlock Text="?" FontSize="10.5" FontWeight="Bold" Foreground="#475569"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Button.Template>
    </Button>
</UserControl>
