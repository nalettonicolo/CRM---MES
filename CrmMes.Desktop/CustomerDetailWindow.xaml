<Window x:Class="CrmMes.Desktop.CustomerDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dettaglio cliente" Icon="Assets/logo.ico" Height="640" Width="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="460" MinWidth="600"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Modifica" Width="100" Height="34" VerticalAlignment="Bottom" Click="Edit_Click" />
            <StackPanel>
                <TextBlock Text="C L I E N T E" Style="{StaticResource MicroLabel}" />
                <TextBlock x:Name="CustomerTitleText" Style="{StaticResource EditorialTitle}" FontSize="26" Margin="0,0,0,4" />
            </StackPanel>
        </DockPanel>
        <TextBlock Grid.Row="1" x:Name="CustomerInfoText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,16" />

        <TextBlock Grid.Row="2" Text="Preventivi" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="4" Margin="0,0,0,16">
            <ListView x:Name="QuotesList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Codice" DisplayMemberBinding="{Binding Code}" Width="200" />
                        <GridViewColumn Header="Stato" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource PillText}" Text="{Binding Status, Converter={StaticResource StatusToItalianText}}" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Foreground}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Creato" DisplayMemberBinding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" Width="100" />
                        <GridViewColumn Header="Valido fino" DisplayMemberBinding="{Binding ValidUntil, StringFormat=dd/MM/yyyy}" Width="100" />
                        <GridViewColumn Header="Totale €" DisplayMemberBinding="{Binding Total, StringFormat=N2}" Width="110" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="4" Text="Commesse" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <Border Grid.Row="5" Style="{StaticResource CardBorder}" Padding="4">
            <ListView x:Name="WorkOrdersList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Codice" DisplayMemberBinding="{Binding Code}" Width="200" />
                        <GridViewColumn Header="Prodotto" DisplayMemberBinding="{Binding ProductName}" Width="180" />
                        <GridViewColumn Header="Q.tà" DisplayMemberBinding="{Binding Quantity, StringFormat=0.##}" Width="60" />
                        <GridViewColumn Header="Stato" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource PillText}" Text="{Binding Status, Converter={StaticResource StatusToItalianText}}" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Foreground}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Consegna" DisplayMemberBinding="{Binding DueDate, StringFormat=dd/MM/yyyy}" Width="100" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</Window>
