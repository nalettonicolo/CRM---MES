<Window x:Class="CrmMes.Desktop.InvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fattura elettronica" Icon="Assets/logo.ico" Height="800" Width="1120" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <DockPanel Margin="24,20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Bottom" Margin="0,0,0,6">
                <TextBlock x:Name="StatusText" Style="{StaticResource PillText}" FontSize="13" />
            </Border>
            <StackPanel>
                <TextBlock Text="F A T T U R A   E L E T T R O N I C A" Style="{StaticResource MicroLabel}" />
                <TextBlock x:Name="HeaderText" Text="Nuova fattura" Style="{StaticResource EditorialTitle}" FontSize="24" />
                <TextBlock x:Name="SubHeaderText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <Grid DockPanel.Dock="Top" x:Name="HeaderPanel" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Cliente" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
                <ComboBox x:Name="CustomerCombo" Height="34" DisplayMemberPath="Name" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Pagamento" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
                <ComboBox x:Name="PaymentCombo" Height="34" SelectedValuePath="Tag">
                    <ComboBoxItem Content="Bonifico" Tag="MP05" IsSelected="True" />
                    <ComboBoxItem Content="RIBA" Tag="MP12" />
                    <ComboBoxItem Content="Contanti" Tag="MP01" />
                    <ComboBoxItem Content="Assegno" Tag="MP02" />
                    <ComboBoxItem Content="Carta di pagamento" Tag="MP08" />
                    <ComboBoxItem Content="SEPA Direct Debit" Tag="MP19" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Scadenza" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
                <DatePicker x:Name="DueDatePicker" Height="34" />
            </StackPanel>
            <StackPanel Grid.Column="6">
                <TextBlock Text="Causale / note" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
                <TextBox x:Name="NotesBox" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" x:Name="SdiPanel" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SdiStatusText" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock x:Name="SdiStatusUpdatedText" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <ComboBox x:Name="SdiNextStatusCombo" Grid.Row="2" Grid.Column="0" Height="34" />
                <TextBox x:Name="SdiTransmissionIdBox" Grid.Row="2" Grid.Column="2" Height="34" MaxLength="100" ToolTip="Protocollo o identificativo dell'invio" />
                <TextBox x:Name="SdiMessageBox" Grid.Row="2" Grid.Column="4" Height="34" MaxLength="1000" ToolTip="Nota dell'intermediario o del portale" />
                <StackPanel Grid.Row="2" Grid.Column="6" Orientation="Horizontal">
                    <Button x:Name="SubmitSdiButton" Content="Invia a SdI" Width="88" Height="34" Margin="0,0,6,0" Click="SubmitSdi_Click" />
                    <Button x:Name="RecordSdiStatusButton" Style="{StaticResource SecondaryButton}" Content="Registra" Width="56" Height="34" Click="RecordSdiStatus_Click" />
                </StackPanel>
                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="7" Margin="0,6,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"
                           Text="Senza intermediario configurato, carica l'XML sul portale Fatture e Corrispettivi e registra qui l'esito." />
            </Grid>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" Content="Elimina bozza" Width="130" Height="36" Margin="0,0,10,0" Click="Delete_Click" />
                <Button x:Name="PdfButton" Style="{StaticResource SecondaryButton}" Content="Copia PDF" Width="110" Height="36" Margin="0,0,10,0" Click="Pdf_Click" />
                <Button x:Name="XmlButton" Style="{StaticResource SecondaryButton}" Content="Scarica XML" Width="120" Height="36" Margin="0,0,10,0" Click="Xml_Click" />
                <Button x:Name="SaveButton" Style="{StaticResource SecondaryButton}" Content="Salva bozza" Width="120" Height="36" Margin="0,0,10,0" Click="Save_Click" />
                <Button x:Name="IssueButton" Content="Emetti fattura" Width="140" Height="36" Click="Issue_Click" />
            </StackPanel>
            <StackPanel>
                <ItemsControl x:Name="WarningsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#A15C07" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="TotalsText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6" x:Name="LineTools">
                <TextBlock Text="Righe" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Style="{StaticResource SecondaryButton}" Content="Aggiungi riga" Height="30" Click="AddLine_Click" />
                <TextBlock Text="IVA 0%: scegli la natura (es. N6.3 subappalto edile, N6.7 settore edile, N3.1 esportazione)." Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <Border Style="{StaticResource CardBorder}" Padding="4">
                <ListView x:Name="LinesList">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Codice" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBox Width="88" Height="30" Text="{Binding Code, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" /></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Descrizione" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBox Width="288" Height="30" Text="{Binding Description, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" /></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Q.tà" Width="76">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBox Width="64" Height="30" Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsEditable}" /></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="U.m." Width="56">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBox Width="44" Height="30" Text="{Binding Unit, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" /></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Prezzo €" Width="96">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBox Width="84" Height="30" Text="{Binding PriceText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsEditable}" /></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Sconto %" Width="72">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBox Width="60" Height="30" Text="{Binding DiscountText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsEditable}" /></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="IVA" Width="84">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Width="72" Height="30" ItemsSource="{Binding VatRates}" SelectedItem="{Binding VatRate, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Natura" Width="96">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Width="84" Height="30" ItemsSource="{Binding Natures}" SelectedItem="{Binding VatNature, Mode=TwoWay}" IsEnabled="{Binding NatureEditable}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Totale €" Width="96" DisplayMemberBinding="{Binding LineTotalText}" />
                            <GridViewColumn Header="" Width="46">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><Button Content="×" Style="{StaticResource SecondaryButton}" Width="32" Height="28" Click="RemoveLine_Click" Tag="{Binding}" IsEnabled="{Binding IsEditable}" /></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
