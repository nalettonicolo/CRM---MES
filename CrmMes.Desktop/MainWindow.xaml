                                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="20">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="DashboardPanelContent">
                                        <TextBlock x:Name="DashboardStatusText" Text="Commesse per stato" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                        <ItemsControl x:Name="DashboardStatusList" Margin="0,0,0,20">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                                <Binding Path="Key" />
                                                                <Binding Path="Value" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Fasi completate nel periodo" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
