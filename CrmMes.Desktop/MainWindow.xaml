                                        <TextBlock Text="Performance media (stimato/effettivo)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                        <TextBlock x:Name="AveragePerformanceText" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />
                                        <TextBlock Text="Commesse completate nel periodo" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                        <TextBlock x:Name="WorkOrdersCompletedText" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />
                                        <TextBlock Text="Percentuale consegne puntuali" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                        <TextBlock x:Name="OnTimeRateText" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />
                                        <TextBlock Text="Disponibilità (fermi macchina)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                        <TextBlock x:Name="AvailabilityText" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />
                                        <TextBlock Text="Qualità (scarti su quantità pianificata)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                        <TextBlock x:Name="QualityText" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />
                                        <TextBlock Text="OEE (Disponibilità × Performance × Qualità)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                        <TextBlock x:Name="OeeText" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                    </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Centri di lavoro">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1*" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Aggiungi" Width="100" Click="AddWorkCenter_Click" />
