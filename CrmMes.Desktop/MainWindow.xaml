                                    <TextBox x:Name="WorkCenterNameBox" DockPanel.Dock="Right" Width="180" Margin="0,0,10,0" Tag="Nome centro" />
                                    <TextBox x:Name="WorkCenterCodeBox" Margin="0,0,10,0" Tag="Codice" />
                                </DockPanel>
                                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                    <ComboBox x:Name="WorkCentersSiteFilterCombo" DockPanel.Dock="Right" Width="170" Height="30" DisplayMemberPath="Name" SelectionChanged="SiteFilter_SelectionChanged" />
