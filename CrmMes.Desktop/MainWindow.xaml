                                                <GridViewColumn Header="Giorni di arretrato" DisplayMemberBinding="{Binding BacklogDays}" Width="130" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Border>
                            </Grid>
                        </TabItem>

