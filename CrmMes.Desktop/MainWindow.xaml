                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Avvisi" DisplayMemberBinding="{Binding WarningCount}" Width="60" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Border>
                            </Grid>
