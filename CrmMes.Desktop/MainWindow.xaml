                                    <TextBlock x:Name="WorkCenterErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>

                                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="4" MinHeight="110">
                                    <ListView x:Name="WorkCentersList" MouseDoubleClick="WorkCentersList_MouseDoubleClick">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Codice" DisplayMemberBinding="{Binding Code}" Width="120" />
                                                <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Name}" Width="220" />
                                                <GridViewColumn Header="Capacità min/giorno" DisplayMemberBinding="{Binding DailyCapacityMinutes}" Width="140" />
                                                <GridViewColumn Header="€/ora" DisplayMemberBinding="{Binding HourlyRate, StringFormat=N2}" Width="90" />
                                                <GridViewColumn Header="" Width="100">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Disattiva" Style="{StaticResource SecondaryButton}" Height="28" Click="DeactivateWorkCenter_Click" Tag="{Binding}" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Border>

                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,8">
                                    <TextBlock Text="Carico rispetto alla capacità (indicativo, non una pianificazione a calendario)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <local:HelpIcon Margin="8,2,0,0"
                                                     Text="Minuti in attesa: somma dei minuti stimati delle fasi non ancora completate (In attesa o In corso) su commesse rilasciate, per questo centro. Operazioni aperte: quante fasi sono in coda. Giorni di arretrato: minuti in attesa diviso capacità giornaliera — una stima di quanti giorni servirebbero per smaltire la coda, non una data precisa. I centri senza capacità registrata compaiono comunque se usati nel ciclo di lavoro, ma senza calcolo dei giorni di arretrato." />
                                </StackPanel>

                                <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="4" MinHeight="110">
