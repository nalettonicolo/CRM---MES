                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Registro del periodo (Excel)" Click="HaccpRegisterExcel_Click" />
                                                <MenuItem Header="Registro del periodo (PDF)" Click="HaccpRegisterPdf_Click" />
                                                <MenuItem Header="Solo non conformità (PDF)" Click="HaccpNonCompliantPdf_Click" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Aggiorna" Width="100" Height="36" Margin="0,0,10,0" Click="RefreshHaccp_Click" />
                                    <TextBlock x:Name="HaccpInfoText" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </DockPanel>
                                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="4">
                                    <ListView x:Name="HaccpPointsList" SelectionMode="Single" MouseDoubleClick="HaccpPointsList_MouseDoubleClick">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Punto di controllo" DisplayMemberBinding="{Binding Name}" Width="240" />
                                                <GridViewColumn Header="Luogo" DisplayMemberBinding="{Binding Location}" Width="140" />
                                                <GridViewColumn Header="Limiti" DisplayMemberBinding="{Binding LimitsText}" Width="120" />
                                                <GridViewColumn Header="Frequenza" DisplayMemberBinding="{Binding Frequency}" Width="150" />
                                                <GridViewColumn Header="Ultima lettura" Width="200">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock x:Name="Last" Text="{Binding LastText}" />
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding LastNonCompliant}" Value="True">
                                                                    <Setter TargetName="Last" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                    <Setter TargetName="Last" Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Border>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Style="{StaticResource SecondaryButton}" Content="Nuovo punto" Width="130" Height="36" Margin="0,0,10,0" Click="NewHaccpPoint_Click" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Modifica punto" Width="140" Height="36" Click="EditHaccpPoint_Click" />
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Rapportini di cantiere">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                                    <Button DockPanel.Dock="Right" Content="Nuovo rapportino" Width="150" Height="36" Click="NewSiteReport_Click" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Pagina tecnici" Width="130" Height="36" Margin="0,0,10,0" Click="OpenTechnicianPage_Click" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Aggiorna" Width="100" Height="36" Margin="0,0,10,0" Click="RefreshSiteReports_Click" />
                                    <ComboBox x:Name="SiteReportStatusFilter" DockPanel.Dock="Right" Width="150" Height="36" Margin="0,0,10,0" SelectionChanged="SiteReportStatusFilter_SelectionChanged">
                                        <ComboBoxItem Content="Tutti" Tag="" IsSelected="True" />
                                        <ComboBoxItem Content="Da firmare" Tag="Draft" />
                                        <ComboBoxItem Content="Firmati" Tag="Signed" />
                                    </ComboBox>
                                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                               Text="I tecnici compilano e fanno firmare dal telefono: apri la Pagina tecnici sul loro dispositivo." />
                                </DockPanel>
                                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="4">
                                    <ListView x:Name="SiteReportsList" SelectionMode="Single" MouseDoubleClick="SiteReportsList_MouseDoubleClick">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Rapportino" DisplayMemberBinding="{Binding Code}" Width="120" />
                                                <GridViewColumn Header="Data" DisplayMemberBinding="{Binding WorkDate, StringFormat=dd/MM/yyyy}" Width="100" />
                                                <GridViewColumn Header="Commessa" DisplayMemberBinding="{Binding WorkOrderCode}" Width="130" />
                                                <GridViewColumn Header="Cliente" DisplayMemberBinding="{Binding CustomerName}" Width="220" />
                                                <GridViewColumn Header="Ore" DisplayMemberBinding="{Binding HoursText}" Width="70" />
                                                <GridViewColumn Header="Stato" Width="110">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource Pill}">
                                                                <TextBlock Style="{StaticResource PillText}" Text="{Binding StatusLabel}" Foreground="{Binding BrushStatus, Converter={StaticResource StatusToBrush}, ConverterParameter=Foreground}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Firmato da" DisplayMemberBinding="{Binding SignedByName}" Width="160" />
                                                <GridViewColumn Header="Tecnico" DisplayMemberBinding="{Binding CreatedBy}" Width="140" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Scadenziario">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                                    <Button DockPanel.Dock="Right" Content="Aggiorna" Width="100" Height="36" Click="RefreshPaymentSchedule_Click" />
                                    <ComboBox x:Name="PaymentScheduleDirectionFilter" DockPanel.Dock="Right" Width="140" Height="36" Margin="0,0,10,0" SelectionChanged="PaymentScheduleFilter_Changed">
                                        <ComboBoxItem Content="Tutte" Tag="" IsSelected="True" />
                                        <ComboBoxItem Content="Da pagare" Tag="Payable" />
                                        <ComboBoxItem Content="Da incassare" Tag="Receivable" />
                                    </ComboBox>
                                    <ComboBox x:Name="PaymentScheduleStatusFilter" DockPanel.Dock="Right" Width="120" Height="36" Margin="0,0,10,0" SelectionChanged="PaymentScheduleFilter_Changed">
                                        <ComboBoxItem Content="Aperte" Tag="Open" IsSelected="True" />
                                        <ComboBoxItem Content="Chiuse" Tag="Paid" />
                                        <ComboBoxItem Content="Tutte" Tag="" />
                                    </ComboBox>
                                    <TextBlock x:Name="PaymentScheduleInfoText" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </DockPanel>
                                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="4">
                                    <ListView x:Name="PaymentScheduleList" SelectionMode="Single">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Scadenza" DisplayMemberBinding="{Binding DueDate, StringFormat=dd/MM/yyyy}" Width="100" />
                                                <GridViewColumn Header="Controparte" DisplayMemberBinding="{Binding CounterpartyName}" Width="220" />
                                                <GridViewColumn Header="Descrizione" DisplayMemberBinding="{Binding Description}" Width="260" />
                                                <GridViewColumn Header="Importo €" DisplayMemberBinding="{Binding Amount, StringFormat=N2}" Width="100" />
                                                <GridViewColumn Header="Tipo" DisplayMemberBinding="{Binding DirectionLabel}" Width="100" />
                                                <GridViewColumn Header="Stato" Width="100">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource Pill}">
                                                                <TextBlock Style="{StaticResource PillText}" Text="{Binding StatusLabel}" Foreground="{Binding BrushStatus, Converter={StaticResource StatusToBrush}, ConverterParameter=Foreground}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                        <ListView.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Segna pagato" Click="MarkScheduleEntryPaid_Click" />
                                                <MenuItem Header="Registra sollecito" Click="RemindScheduleEntry_Click" />
                                            </ContextMenu>
                                        </ListView.ContextMenu>
                                    </ListView>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Fatture passive">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                                    <Button DockPanel.Dock="Right" Content="Importa XML..." Width="130" Height="36" Click="ImportPurchaseInvoice_Click" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Aggiorna" Width="100" Height="36" Margin="0,0,10,0" Click="RefreshPurchaseInvoices_Click" />
                                    <TextBlock x:Name="PurchaseInvoicesInfoText" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </DockPanel>
                                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="4">
                                    <ListView x:Name="PurchaseInvoicesList" SelectionMode="Single">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Numero" DisplayMemberBinding="{Binding DocumentNumber}" Width="100" />
                                                <GridViewColumn Header="Data" DisplayMemberBinding="{Binding DocumentDate, StringFormat=dd/MM/yyyy}" Width="100" />
                                                <GridViewColumn Header="Fornitore" DisplayMemberBinding="{Binding SupplierName}" Width="260" />
                                                <GridViewColumn Header="Imponibile €" DisplayMemberBinding="{Binding TaxableTotal, StringFormat=N2}" Width="110" />
                                                <GridViewColumn Header="Scadenze aperte" DisplayMemberBinding="{Binding OpenInstallments}" Width="120" />
                                                <GridViewColumn Header="Importata" DisplayMemberBinding="{Binding ImportedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="130" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Fatture">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                                    <Button DockPanel.Dock="Right" Content="Fattura da DDT" Width="140" Height="36" Click="InvoiceFromDocuments_Click" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Nuova fattura" Width="130" Height="36" Margin="0,0,10,0" Click="NewInvoice_Click" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Aggiorna" Width="100" Height="36" Margin="0,0,10,0" Click="RefreshInvoices_Click" />
                                    <ComboBox x:Name="InvoiceStatusFilter" DockPanel.Dock="Right" Width="150" Height="36" Margin="0,0,10,0" SelectionChanged="InvoiceStatusFilter_SelectionChanged">
                                        <ComboBoxItem Content="Tutte" Tag="" IsSelected="True" />
                                        <ComboBoxItem Content="Bozze" Tag="Draft" />
                                        <ComboBoxItem Content="Emesse" Tag="Issued" />
                                    </ComboBox>
                                    <TextBlock x:Name="InvoicesInfoText" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </DockPanel>
                                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="4">
                                    <ListView x:Name="InvoicesList" SelectionMode="Single" MouseDoubleClick="InvoicesList_MouseDoubleClick">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Numero" DisplayMemberBinding="{Binding Code}" Width="100" />
                                                <GridViewColumn Header="Data" DisplayMemberBinding="{Binding IssueDate, StringFormat=dd/MM/yyyy}" Width="100" />
                                                <GridViewColumn Header="Cliente" DisplayMemberBinding="{Binding CustomerName}" Width="260" />
                                                <GridViewColumn Header="Tipo" DisplayMemberBinding="{Binding TypeLabel}" Width="130" />
                                                <GridViewColumn Header="Totale €" DisplayMemberBinding="{Binding Total, StringFormat=N2}" Width="120" />
                                                <GridViewColumn Header="Stato" Width="110">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource Pill}">
                                                                <TextBlock Style="{StaticResource PillText}" Text="{Binding StatusLabel}" Foreground="{Binding BrushStatus, Converter={StaticResource StatusToBrush}, ConverterParameter=Foreground}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
