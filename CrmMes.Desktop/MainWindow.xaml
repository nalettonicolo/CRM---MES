<Window x:Class="CrmMes.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrmMes.Desktop"
        mc:Ignorable="d"
        Title="Nicolò - MES" Icon="Assets/logo.ico" Height="720" Width="1240"
        MinHeight="580" MinWidth="1000"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        Background="{DynamicResource BackgroundBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarBgBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Text="N I C O L Ò   ·   M E S" Margin="12,0,0,0" Foreground="{StaticResource TitleBarTextBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeButton_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="MaximizeButton_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="CloseButton_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!-- Login -->
            <Grid x:Name="LoginPanel" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                <Border Style="{StaticResource CardBorder}" Padding="32,30">
                    <StackPanel>
                        <TextBlock Text="Accedi" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24" />
                        <TextBlock Text="Email" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                        <TextBox x:Name="EmailBox" />
                        <TextBlock Text="Password" Margin="0,18,0,5" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                        <PasswordBox x:Name="PasswordBox" />
                        <Button x:Name="LoginButton" Content="ACCEDI →" Height="42" Margin="0,26,0,0" Click="LoginButton_Click" IsEnabled="False" />
                        <TextBlock x:Name="LoginError" Margin="0,12,0,0" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                        <Button x:Name="LoginSettingsButton" Style="{StaticResource SidebarLinkButton}" Content="Impostazioni server" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,18,0,0" Click="SettingsButton_Click" />
                        <Button x:Name="LoginSupportButton" Style="{StaticResource SidebarLinkButton}" Content="Teleassistenza" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" Click="SupportButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Dashboard -->
            <Grid x:Name="DashboardPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation dock: detached from the window edges (floating), not a flush structural
                     column — a deliberate break from the fixed-sidebar SaaS convention. -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="1" Margin="14,18,0,18">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="0,1,0,0" Padding="18,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource PrimaryBrush}" Margin="0,0,8,0" />
                                    <TextBlock x:Name="ConnectionStatus" Text="Connessione..." Foreground="{StaticResource SidebarTextActiveBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="BusyIndicator" Text="" Foreground="{StaticResource SidebarTextBrush}" FontStyle="Italic" FontSize="11" Margin="0,8,0,0" />
                                <Button x:Name="UpdateButton" Style="{StaticResource SidebarLinkButton}" Content="Controlla aggiornamenti" Margin="0,10,0,0" Click="UpdateButton_Click" />
                                <Button x:Name="ChangePasswordButton" Style="{StaticResource SidebarLinkButton}" Content="Cambia password" Margin="0,6,0,0" Click="ChangePasswordButton_Click" />
                                <Button x:Name="SecurityButton" Style="{StaticResource SidebarLinkButton}" Content="Verifica in due passaggi" Margin="0,6,0,0" Click="SecurityButton_Click" />
                                <Button x:Name="ServiceButton" Style="{StaticResource SidebarLinkButton}" Content="Service post-vendita" Margin="0,6,0,0" Click="ServiceButton_Click" Visibility="Collapsed" />
                                <Button x:Name="EnergyButton" Style="{StaticResource SidebarLinkButton}" Content="Monitoraggio energetico" Margin="0,6,0,0" Click="EnergyButton_Click" Visibility="Collapsed" />
                                <Button x:Name="SupportButton" Style="{StaticResource SidebarLinkButton}" Content="Teleassistenza" Margin="0,6,0,0" Click="SupportButton_Click" />
                                <Button x:Name="SidebarSettingsButton" Style="{StaticResource SidebarLinkButton}" Content="Impostazioni server" Margin="0,6,0,0" Click="SettingsButton_Click" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,10,0,0">
                            <Expander x:Name="NavSalesSection" Style="{StaticResource NavSectionExpander}" Header="V E N D I T E">
                                <StackPanel>
                                    <RadioButton x:Name="NavCustomers" Style="{StaticResource NavItem}" GroupName="Nav" Tag="20" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Clienti" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavQuotes" Style="{StaticResource NavItem}" GroupName="Nav" Tag="21" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Preventivi" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavInvoices" Style="{StaticResource NavItem}" GroupName="Nav" Tag="27" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Fatture" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavPaymentSchedule" Style="{StaticResource NavItem}" GroupName="Nav" Tag="28" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Scadenziario" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Expander>

                            <Expander Style="{StaticResource NavSectionExpander}" Header="M A G A Z Z I N O">
                                <StackPanel>
                                    <RadioButton x:Name="NavMaterials" Style="{StaticResource NavItem}" GroupName="Nav" Tag="0" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Materiali" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavLowStock" Style="{StaticResource NavItem}" GroupName="Nav" Tag="1" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Sotto scorta" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavMissing" Style="{StaticResource NavItem}" GroupName="Nav" Tag="2" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Materiali mancanti" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavSlips" Style="{StaticResource NavItem}" GroupName="Nav" Tag="3" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Distinte di prelievo" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavMaterialLots" Style="{StaticResource NavItem}" GroupName="Nav" Tag="9" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8AB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Lotti materiali" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="NavPurchasingSection" Style="{StaticResource NavSectionExpander}" Header="A C Q U I S T I">
                                <StackPanel>
                                    <RadioButton x:Name="NavOrders" Style="{StaticResource NavItem}" GroupName="Nav" Tag="4" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BF;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Ordini fornitore" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavSuppliers" Style="{StaticResource NavItem}" GroupName="Nav" Tag="14" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE719;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Fornitori" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavCatalogSearch" Style="{StaticResource NavItem}" GroupName="Nav" Tag="15" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Ricerca catalogo" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavPurchaseInvoices" Style="{StaticResource NavItem}" GroupName="Nav" Tag="29" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Fatture passive" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavSubcontracting" Style="{StaticResource NavItem}" GroupName="Nav" Tag="24" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8AB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Conto lavoro" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Expander>

                            <Expander Style="{StaticResource NavSectionExpander}" Header="P R O D U Z I O N E">
                                <StackPanel>
                                    <RadioButton x:Name="NavProducts" Style="{StaticResource NavItem}" GroupName="Nav" Tag="7" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Prodotti" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavWorkOrders" Style="{StaticResource NavItem}" GroupName="Nav" Tag="8" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Commesse" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavWorkCenters" Style="{StaticResource NavItem}" GroupName="Nav" Tag="11" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Centri di lavoro" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" GroupName="Nav" Tag="10" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Cruscotto" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavPlanning" Style="{StaticResource NavItem}" GroupName="Nav" Tag="19" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Pianificazione" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavHaccp" Style="{StaticResource NavItem}" GroupName="Nav" Tag="25" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9CA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Registri HACCP" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavSiteReports" Style="{StaticResource NavItem}" GroupName="Nav" Tag="26" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Rapportini di cantiere" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <Button x:Name="ShopFloorTerminalButton" Style="{StaticResource SidebarLinkButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="26,6,10,0" Click="ShopFloorTerminalButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Terminale di reparto" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PlanningBoardButton" Style="{StaticResource SidebarLinkButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="26,6,10,0" Click="PlanningBoardButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Planning produzione" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="NavMaintenanceSection" Style="{StaticResource NavSectionExpander}" Header="M A N U T E N Z I O N E">
                                <StackPanel>
                                    <RadioButton x:Name="NavEquipment" Style="{StaticResource NavItem}" GroupName="Nav" Tag="17" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE770;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Macchine" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavMaintenance" Style="{StaticResource NavItem}" GroupName="Nav" Tag="18" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE90F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Manutenzione" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="NavShippingSection" Style="{StaticResource NavSectionExpander}" Header="S P E D I Z I O N I">
                                <StackPanel>
                                    <RadioButton x:Name="NavCarriers" Style="{StaticResource NavItem}" GroupName="Nav" Tag="12" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7C1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Corrieri" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavShipments" Style="{StaticResource NavItem}" GroupName="Nav" Tag="13" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE709;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Spedizioni" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavTransportDocuments" Style="{StaticResource NavItem}" GroupName="Nav" Tag="23" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Documenti di trasporto" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Expander>

                            <!-- Management-only area: shown after login to Admin/Management (see CompleteLogin).
                                 The API enforces the same rule, this only avoids offering what would be refused. -->
                            <Expander x:Name="NavManagementSection" Style="{StaticResource NavSectionExpander}" Header="D I R E Z I O N E" Visibility="Collapsed">
                                <StackPanel>
                                    <RadioButton x:Name="NavMargins" Style="{StaticResource NavItem}" GroupName="Nav" Tag="22" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Controllo margini" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Expander>

                            <Expander Style="{StaticResource NavSectionExpander}" Header="A M M I N I S T R A Z I O N E">
                                <StackPanel>
                                    <RadioButton x:Name="NavAreas" Style="{StaticResource NavItem}" GroupName="Nav" Tag="5" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Aree" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavUsers" Style="{StaticResource NavItem}" GroupName="Nav" Tag="6" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Utenti" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="NavSites" Style="{StaticResource NavItem}" GroupName="Nav" Tag="16" Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE81D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Sedi" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <Button x:Name="CompanyFiscalButton" Style="{StaticResource SidebarLinkButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="26,6,10,0" Click="CompanyFiscalButton_Click" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Dati per le fatture" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AccessChannelsButton" Style="{StaticResource SidebarLinkButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="26,6,10,0" Click="AccessChannelsButton_Click" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Canali di accesso" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AppearanceButton" Style="{StaticResource SidebarLinkButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="26,6,10,0" Click="AppearanceButton_Click" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Aspetto grafico" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="CompanySetupButton" Style="{StaticResource SidebarLinkButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="26,6,10,0" Click="CompanySetupButton_Click" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="24" />
                                            <TextBlock Text="Azienda e settore" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Content -->
                <Grid Grid.Column="1" Margin="40,30,36,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,26">
                        <Border x:Name="LicenseBanner" Visibility="Collapsed" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" Background="{StaticResource WarningSoftBrush}">
                            <TextBlock x:Name="LicenseBannerText" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource WarningTextBrush}" />
                        </Border>
                        <TextBlock x:Name="PageEyebrow" Text="M A G A Z Z I N O" Style="{StaticResource MicroLabel}" Margin="2,0,0,-2" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PageTitle" Text="Materiali" Style="{StaticResource EditorialTitle}" VerticalAlignment="Center" />
                            <local:HelpIcon x:Name="PageHelpIcon" Margin="12,10,0,0" VerticalAlignment="Top" />
                        </StackPanel>
                    </StackPanel>

                    <TabControl Grid.Row="1" x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">

                        <TabItem Header="Materiali">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                                    <Button DockPanel.Dock="Right" Content="Nuovo materiale" Width="140" Height="36" Click="NewMaterialButton_Click" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Esporta Excel" Width="120" Height="36" Margin="0,0,10,0" Click="ExportArticlesButton_Click" />
                                    <Button x:Name="ImportArticlesButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Importa da Excel" Width="140" Height="36" Margin="0,0,10,0" Click="ImportArticlesButton_Click" />
