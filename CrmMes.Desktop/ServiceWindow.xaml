<Window x:Class="CrmMes.Desktop.ServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Service post-vendita" Icon="Assets/logo.ico" Height="760" Width="1080"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="560" MinWidth="820"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="S E R V I C E   P O S T - V E N D I T A" Style="{StaticResource MicroLabel}" />
            <TextBlock x:Name="WarrantyNoticeText" Foreground="{StaticResource WarningTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Aggiorna" Style="{StaticResource SecondaryButton}" Width="100" Height="32" Click="Refresh_Click" />
        </DockPanel>

        <TabControl Grid.Row="2" x:Name="Tabs" Margin="0,10,0,0">
            <TabItem Header="Richieste di assistenza">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <ComboBox DockPanel.Dock="Left" x:Name="RequestStatusFilter" Width="160" Height="32" SelectionChanged="RequestStatusFilter_SelectionChanged">
                            <ComboBoxItem Content="Tutti gli stati" Tag="" IsSelected="True" />
                            <ComboBoxItem Content="Aperte" Tag="Open" />
                            <ComboBoxItem Content="In lavorazione" Tag="InProgress" />
                            <ComboBoxItem Content="Chiuse" Tag="Closed" />
                        </ComboBox>
                    </DockPanel>

                    <ListView Grid.Row="1" x:Name="RequestsList" SelectionChanged="RequestsList_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="N." DisplayMemberBinding="{Binding NumberLabel}" Width="60" />
                                <GridViewColumn Header="Cliente" DisplayMemberBinding="{Binding CustomerName}" Width="150" />
                                <GridViewColumn Header="Macchina" DisplayMemberBinding="{Binding MachineLabel}" Width="180" />
                                <GridViewColumn Header="Oggetto" DisplayMemberBinding="{Binding Subject}" Width="220" />
                                <GridViewColumn Header="Priorità" DisplayMemberBinding="{Binding PriorityLabel}" Width="80" />
                                <GridViewColumn Header="Aperta" DisplayMemberBinding="{Binding OpenedLabel}" Width="100" />
                                <GridViewColumn Header="Stato" DisplayMemberBinding="{Binding StatusLabel}" Width="110" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="2" x:Name="RequestDetailPanel" Style="{StaticResource CardBorder}" Padding="14" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="RequestDetailText" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Tecnico" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="TechnicianBox" Width="140" Margin="0,0,10,0" />
                                <TextBlock Text="Ore" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="HoursBox" Width="60" Margin="0,0,10,0" />
                                <CheckBox x:Name="InWarrantyBox" Content="In garanzia" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <CheckBox x:Name="CompletedBox" Content="Visita completata" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox x:Name="InterventionDescriptionBox" Margin="0,8,0,0" AcceptsReturn="True" TextWrapping="Wrap" Height="50"
                                     Tag="Descrizione dell'intervento" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="AddInterventionButton" Content="Registra intervento" Width="160" Height="32" Margin="0,0,10,0" Click="AddIntervention_Click" />
                                <Button x:Name="CloseRequestButton" Style="{StaticResource SecondaryButton}" Content="Chiudi richiesta" Width="130" Height="32" Margin="0,0,10,0" Click="CloseRequest_Click" />
                                <Button x:Name="ReopenRequestButton" Style="{StaticResource SecondaryButton}" Content="Riapri richiesta" Width="130" Height="32" Click="ReopenRequest_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Macchine installate">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListView Grid.Row="0" x:Name="MachinesList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Macchina" DisplayMemberBinding="{Binding Name}" Width="160" />
                                <GridViewColumn Header="Matricola" DisplayMemberBinding="{Binding SerialNumber}" Width="130" />
                                <GridViewColumn Header="Cliente" DisplayMemberBinding="{Binding CustomerName}" Width="160" />
                                <GridViewColumn Header="Ubicazione" DisplayMemberBinding="{Binding Location}" Width="150" />
                                <GridViewColumn Header="Garanzia" DisplayMemberBinding="{Binding WarrantyLabel}" Width="150" />
                                <GridViewColumn Header="Richieste aperte" DisplayMemberBinding="{Binding OpenRequestCount}" Width="110" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="1" x:Name="NewMachinePanel" Style="{StaticResource CardBorder}" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Nuova macchina installata" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="NewMachineCustomerCombo" Width="200" Height="32" DisplayMemberPath="Name" Margin="0,0,10,0" />
                                <TextBox x:Name="NewMachineNameBox" Width="160" Tag="Nome" Margin="0,0,10,0" />
                                <TextBox x:Name="NewMachineModelBox" Width="110" Tag="Modello" Margin="0,0,10,0" />
                                <TextBox x:Name="NewMachineSerialBox" Width="130" Tag="Matricola" Margin="0,0,10,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBox x:Name="NewMachineLocationBox" Width="160" Tag="Ubicazione" Margin="0,0,10,0" />
                                <TextBlock Text="Garanzia fino al" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <DatePicker x:Name="NewMachineWarrantyPicker" Width="140" Margin="0,0,10,0" />
                                <Button Content="Registra macchina" Width="150" Height="32" Click="CreateMachine_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
