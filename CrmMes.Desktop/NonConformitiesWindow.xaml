<Window x:Class="CrmMes.Desktop.NonConformitiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CrmMes.Desktop"
        Title="Non conformità" Icon="Assets/logo.ico" Height="560" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="440" MinWidth="560"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="N O N   C O N F O R M I T À" Style="{StaticResource MicroLabel}" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock x:Name="OperationNameText" Style="{StaticResource EditorialTitle}" FontSize="26" Margin="0,0,0,4" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="Segnala una non conformità" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
            <TextBlock Text="Descrizione (es. Fuori tolleranza, Difetto estetico, Rottura in collaudo)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
            <TextBox x:Name="DescriptionBox" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Note (opzionale)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <TextBox x:Name="NotesBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Quantità scarto" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <TextBox x:Name="ScrapQuantityBox" Text="1" />
                </StackPanel>
            </Grid>
            <StackPanel x:Name="UnitPickerPanel" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock Text="Unità interessata (opzionale — scarta quella unità specifica)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                <ComboBox x:Name="UnitCombo" DisplayMemberPath="SerialNumber" />
            </StackPanel>
            <Button Content="Segnala non conformità" Width="180" Height="34" HorizontalAlignment="Right" Click="RegisterNonConformity_Click" />
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Storico" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,18,0,8" />

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="4">
            <ListView x:Name="NonConformitiesList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Descrizione" DisplayMemberBinding="{Binding Description}" Width="200" />
                        <GridViewColumn Header="Note" DisplayMemberBinding="{Binding Notes}" Width="150" />
                        <GridViewColumn Header="Quantità" DisplayMemberBinding="{Binding ScrapQuantity}" Width="80" />
                        <GridViewColumn Header="Rilevata" DisplayMemberBinding="{Binding DetectedAt, StringFormat={}{0:g}}" Width="130" />
                        <GridViewColumn Header="Segnalata da" DisplayMemberBinding="{Binding ReportedBy}" Width="110" />
                        <GridViewColumn Header="Unità" DisplayMemberBinding="{Binding UnitSerialNumber}" Width="130" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</Window>
