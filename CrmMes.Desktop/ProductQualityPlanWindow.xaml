<Window x:Class="CrmMes.Desktop.ProductQualityPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Piano di controllo qualità" Icon="Assets/logo.ico" Height="560" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="420" MinWidth="560"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="P I A N O   D I   C O N T R O L L O" Style="{StaticResource MicroLabel}" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock x:Name="ProductTitleText" Style="{StaticResource EditorialTitle}" FontSize="24" Margin="0,0,0,4" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Caratteristiche da misurare per questo prodotto, con tolleranza — usate poi per registrare misurazioni e generare il certificato di conformità di una commessa." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,14" />

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Nuova caratteristica" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                <UniformGrid Columns="3" Rows="2">
                    <StackPanel Margin="0,0,10,10">
                        <TextBlock Text="Nome" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,0,4" />
                        <TextBox x:Name="NameBox" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,10">
                        <TextBlock Text="Unità (opz.)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,0,4" />
                        <TextBox x:Name="UnitBox" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Nominale (opz.)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,0,4" />
                        <TextBox x:Name="NominalBox" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Limite inferiore (opz.)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,0,4" />
                        <TextBox x:Name="LowerBox" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Limite superiore (opz.)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,0,4" />
                        <TextBox x:Name="UpperBox" />
                    </StackPanel>
                    <Button Content="Aggiungi" Height="34" VerticalAlignment="Bottom" Click="AddCheckpoint_Click" />
                </UniformGrid>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="4">
            <ListView x:Name="CheckpointsList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Name}" Width="180" />
                        <GridViewColumn Header="Unità" DisplayMemberBinding="{Binding Unit}" Width="80" />
                        <GridViewColumn Header="Nominale" DisplayMemberBinding="{Binding NominalValue}" Width="90" />
                        <GridViewColumn Header="Min" DisplayMemberBinding="{Binding LowerLimit}" Width="80" />
                        <GridViewColumn Header="Max" DisplayMemberBinding="{Binding UpperLimit}" Width="80" />
                        <GridViewColumn Header="" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Rimuovi" Style="{StaticResource SecondaryButton}" Height="28" Click="RemoveCheckpoint_Click" Tag="{Binding}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Chiudi" Width="100" Height="36" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
