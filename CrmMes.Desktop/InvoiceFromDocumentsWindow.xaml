<Window x:Class="CrmMes.Desktop.InvoiceFromDocumentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fattura da DDT" Icon="Assets/logo.ico" Width="640" Height="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="F A T T U R A   D I F F E R I T A" Style="{StaticResource MicroLabel}" />
            <TextBlock Text="DDT da fatturare" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,10"
                       Text="Scegli il cliente e spunta i DDT emessi da mettere nella stessa fattura. La fattura differita va emessa entro il 15 del mese successivo ai DDT." />
            <ComboBox x:Name="CustomerCombo" Height="34" DisplayMemberPath="Name" SelectionChanged="CustomerCombo_SelectionChanged" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Content="Annulla" Width="100" Height="36" Margin="0,0,10,0" IsCancel="True" />
                <Button x:Name="CreateButton" Content="Crea bozza" Width="130" Height="36" Click="Create_Click" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <Border Style="{StaticResource CardBorder}" Padding="8">
            <ItemsControl x:Name="DocumentsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,4">
                            <TextBlock>
                                <Run Text="{Binding DocumentCode, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding DateText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
                                <Run Text="{Binding Reason, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
                            </TextBlock>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </DockPanel>
</Window>
