<Window x:Class="CrmMes.Desktop.WorkOrderLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Etichetta commessa" Icon="Assets/logo.ico" Height="640" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="600" MinWidth="360"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="E T I C H E T T A   Q R" Style="{StaticResource MicroLabel}" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock Text="Etichetta commessa" Style="{StaticResource EditorialTitle}" FontSize="26" Margin="0,0,0,4" />
            <TextBlock Text="Stampa e allega al lotto: il reparto la scansiona al Terminale di reparto per aprire questa commessa." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="20" Margin="0,16,0,0">
            <StackPanel VerticalAlignment="Center">
                <Image x:Name="QrImage" Width="220" Height="220" HorizontalAlignment="Center" />
                <TextBlock x:Name="CodeText" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock x:Name="ProductText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock x:Name="LotText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Esporta PDF" Width="130" Height="36" Margin="0,0,10,0" Click="ExportPdf_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="Chiudi" Width="100" Height="36" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
