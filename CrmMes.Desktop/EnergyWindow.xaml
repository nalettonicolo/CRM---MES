<Window x:Class="CrmMes.Desktop.EnergyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitoraggio energetico" Icon="Assets/logo.ico" Height="760" Width="1080"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="560" MinWidth="860"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Content="Aggiorna" Style="{StaticResource SecondaryButton}" Width="100" Height="32" Click="Refresh_Click" />
            <StackPanel>
                <TextBlock Text="M O N I T O R A G G I O   E N E R G E T I C O" Style="{StaticResource MicroLabel}" />
                <TextBlock Text="Progetti di efficientamento: periodo di riferimento (ex ante) e periodo successivo (ex post), per l'iperammortamento."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="4" Margin="0,10,0,0">
            <ListView x:Name="ProjectsList" SelectionChanged="ProjectsList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Macchina" DisplayMemberBinding="{Binding EquipmentLabel}" Width="170" />
                        <GridViewColumn Header="Progetto" DisplayMemberBinding="{Binding Title}" Width="220" />
                        <GridViewColumn Header="Ex ante" DisplayMemberBinding="{Binding BaselineLabel}" Width="220" />
                        <GridViewColumn Header="Ex post" DisplayMemberBinding="{Binding AfterLabel}" Width="220" />
                        <GridViewColumn Header="Risparmio" DisplayMemberBinding="{Binding SavingsLabel}" Width="100" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Border Grid.Row="2" x:Name="AfterPeriodPanel" Style="{StaticResource CardBorder}" Padding="14" Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="AfterPeriodTitleText" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Dal" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker x:Name="AfterFromPicker" Width="140" Margin="0,0,16,0" />
                    <TextBlock Text="Al" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker x:Name="AfterToPicker" Width="140" Margin="0,0,16,0" />
                    <Button Content="Salva periodo" Width="120" Height="32" Margin="0,0,10,0" Click="SaveAfterPeriod_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Annulla periodo" Width="130" Height="32" Margin="0,0,10,0" Click="ClearAfterPeriod_Click" />
                    <Button Style="{StaticResource DangerButton}" Content="Elimina progetto" Width="130" Height="32" Click="DeleteProject_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="14" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Nuovo progetto" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="NewProjectEquipmentCombo" Width="190" Height="32" DisplayMemberPath="Name" Margin="0,0,10,0" />
                    <TextBox x:Name="NewProjectTitleBox" Width="220" Tag="Titolo del progetto" Margin="0,0,10,0" />
                    <TextBlock Text="Ex ante dal" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker x:Name="NewProjectFromPicker" Width="130" Margin="0,0,10,0" />
                    <TextBlock Text="al" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker x:Name="NewProjectToPicker" Width="130" Margin="0,0,10,0" />
                    <Button Content="Crea progetto" Width="120" Height="32" Click="CreateProject_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="Consumo macchina" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="LookupEquipmentCombo" Width="190" Height="32" DisplayMemberPath="Name" Margin="0,0,10,0" />
                    <DatePicker x:Name="LookupFromPicker" Width="130" Margin="0,0,6,0" />
                    <DatePicker x:Name="LookupToPicker" Width="130" Margin="0,0,10,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Calcola" Width="90" Height="32" Click="LookupEquipment_Click" />
                    <TextBlock x:Name="LookupResultText" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Consumo commessa" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="WorkOrderCodeBox" Width="220" Tag="Codice commessa" Margin="0,0,10,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Calcola" Width="90" Height="32" Click="LookupWorkOrder_Click" />
                    <TextBlock x:Name="WorkOrderResultText" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
