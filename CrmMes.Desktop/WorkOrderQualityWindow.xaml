<Window x:Class="CrmMes.Desktop.WorkOrderQualityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controlli qualità" Icon="Assets/logo.ico" Height="600" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinHeight="460" MinWidth="620"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="C O N T R O L L I   Q U A L I T À" Style="{StaticResource MicroLabel}" Foreground="{StaticResource PrimaryBrush}" />
            <TextBlock x:Name="OrderTitleText" Style="{StaticResource EditorialTitle}" FontSize="24" Margin="0,0,0,4" />
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="InfoText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,14" />

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Registra misurazione" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Registra" Width="100" Height="34" Click="RecordMeasurement_Click" />
                    <TextBox x:Name="ValueBox" DockPanel.Dock="Right" Width="100" Margin="0,0,10,0" Tag="Valore misurato" />
                    <ComboBox x:Name="CheckpointCombo" DisplayMemberPath="Name" Margin="0,0,10,0" />
                </DockPanel>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="4">
            <ListView x:Name="MeasurementsList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Caratteristica" DisplayMemberBinding="{Binding CheckpointName}" Width="160" />
                        <GridViewColumn Header="Valore" DisplayMemberBinding="{Binding MeasuredValue}" Width="80" />
                        <GridViewColumn Header="Unità" DisplayMemberBinding="{Binding Unit}" Width="60" />
                        <GridViewColumn Header="Min" DisplayMemberBinding="{Binding LowerLimit}" Width="70" />
                        <GridViewColumn Header="Max" DisplayMemberBinding="{Binding UpperLimit}" Width="70" />
                        <GridViewColumn Header="Esito" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IsWithinTolerance, Converter={StaticResource BoolToText}, ConverterParameter=Conforme|Non conforme}" Foreground="{Binding IsWithinTolerance, Converter={StaticResource BoolToBrush}, ConverterParameter=Foreground}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Quando" DisplayMemberBinding="{Binding MeasuredAt}" Width="130" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Genera certificato PDF" Width="180" Height="36" Margin="0,0,10,0" Click="GenerateCertificate_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="Chiudi" Width="100" Height="36" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
