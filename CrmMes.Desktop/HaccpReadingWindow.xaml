<Window x:Class="CrmMes.Desktop.HaccpReadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registra lettura HACCP" Icon="Assets/logo.ico" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="H A C C P" Style="{StaticResource MicroLabel}" />
        <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
        <TextBlock x:Name="LimitsText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,2,0,14" />

        <StackPanel x:Name="ValuePanel">
            <TextBlock x:Name="ValueLabel" Text="Valore misurato" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
            <TextBox x:Name="ValueBox" Margin="0,0,0,12" TextChanged="Input_Changed" />
        </StackPanel>
        <StackPanel x:Name="YesNoPanel" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
            <RadioButton x:Name="CompliantRadio" Content="Conforme" GroupName="Outcome" Margin="0,0,20,0" Checked="Input_Changed" />
            <RadioButton x:Name="NonCompliantRadio" Content="Non conforme" GroupName="Outcome" Checked="Input_Changed" />
        </StackPanel>

        <TextBlock x:Name="OutcomeText" FontWeight="SemiBold" Margin="0,0,0,10" />
        <StackPanel x:Name="ActionPanel" Visibility="Collapsed">
            <TextBlock Text="Azione correttiva eseguita *" Foreground="{StaticResource DangerBrush}" FontSize="12.5" Margin="0,0,0,5" />
            <TextBox x:Name="ActionBox" Height="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,12" />
        </StackPanel>
        <TextBlock Text="Note" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
        <TextBox x:Name="NotesBox" Margin="0,0,0,10" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButton}" Content="Annulla" Width="100" Height="36" Margin="0,0,10,0" IsCancel="True" />
            <Button x:Name="SaveButton" Content="Registra" Width="110" Height="36" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
