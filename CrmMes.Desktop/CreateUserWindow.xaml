<Window x:Class="CrmMes.Desktop.CreateUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuovo utente" Icon="Assets/logo.ico" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="Nuovo utente" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,18" />

        <TextBlock Text="Nome" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
        <TextBox x:Name="NameBox" Margin="0,0,0,14" />

        <TextBlock Text="Email" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
        <TextBox x:Name="EmailBox" Margin="0,0,0,14" />

        <TextBlock Text="Password (almeno 8 caratteri)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,14" />

        <TextBlock Text="Ruolo" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,0,5" />
        <ComboBox x:Name="RoleCombo" Height="34" Margin="0,0,0,10" SelectedIndex="3">
            <ComboBoxItem Content="Admin" />
            <ComboBoxItem Content="Warehouse" />
            <ComboBoxItem Content="Purchasing" />
            <ComboBoxItem Content="Operator" />
        </ComboBox>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Annulla" Width="100" Height="36" Margin="0,0,10,0" Click="Cancel_Click" />
            <Button x:Name="CreateButton" Content="Crea utente" Width="140" Height="36" Click="Create_Click" />
        </StackPanel>
    </StackPanel>
</Window>
