  "token": "INCOLLA-QUI-IL-TOKEN-GENERATO-NEL-GESTIONALE",
  "heartbeat_seconds": 60,
  "queue_file": "pending-readings.json",

  "opcua": {
    "endpoint": "opc.tcp://192.168.1.50:4840",
