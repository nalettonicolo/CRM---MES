    "nodes": {
      "state": "ns=2;s=Machine.State",
      "pieces": "ns=2;s=Machine.PartCounter",
      "scrap": "ns=2;s=Machine.ScrapCounter",
      "alarm": "ns=2;s=Machine.ActiveAlarm"
    },
    "state_map": { "0": "Off", "1": "Running", "2": "Idle", "3": "Setup", "4": "Stopped", "5": "Alarm" }
  },

  "_mqtt_example": {
    "host": "192.168.1.60",
    "port": 1883,
    "topics": {
      "fabbrica/pressa1/stato": "state",
      "fabbrica/pressa1/pezzi": "pieces",
      "fabbrica/pressa1/allarme": "alarm"
    },
    "state_map": { "RUN": "Running", "IDLE": "Idle", "STOP": "Stopped", "ALARM": "Alarm" }
  }
