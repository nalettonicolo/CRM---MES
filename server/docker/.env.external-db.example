# Per docker-compose.external-db.yml. Copia questo file in .env (stessa cartella) e sostituisci i segnaposto.
# Il file .env contiene segreti: non inviarlo per email e non metterlo nel repository.

# Connessione al PostgreSQL già esistente (formato URI o Npgsql, come già usato per DATABASE_URL).
DATABASE_URL=CAMBIA_CON_LA_CONNECTION_STRING_DEL_DATABASE

# Chiave di firma dei token: almeno 32 caratteri casuali.   openssl rand -base64 48
JWT_KEY=CAMBIA_CON_UNA_CHIAVE_CASUALE_DI_ALMENO_32_CARATTERI

# Porta su cui risponde il gestionale (programma desktop, /app/ e /tecnici/).
PORT=5092

# Contatti mostrati nella finestra Teleassistenza del programma.
SUPPORT_NAME=
SUPPORT_PHONE=
SUPPORT_EMAIL=
# Server RustDesk proprio per la teleassistenza (vuoto = server pubblico RustDesk).
RUSTDESK_SERVER=
RUSTDESK_KEY=
