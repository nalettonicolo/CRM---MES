# Copia questo file in .env (stessa cartella) e compila. Il file .env contiene segreti: non inviarlo per email
# e non metterlo nel repository.
#
# Valori casuali sicuri, su Linux:
#   openssl rand -base64 32        (DB_PASSWORD, senza caratteri ; o ")
#   openssl rand -base64 48        (JWT_KEY, almeno 32 caratteri)

DB_PASSWORD=
JWT_KEY=

# Porta su cui risponde il gestionale (programma desktop, /app/ e /tecnici/).
PORT=5092

# Cartella dei backup notturni sul server (meglio se su un disco diverso o un NAS montato).
BACKUP_DIR=./backup
BACKUP_RETENTION_DAYS=30

# Contatti mostrati nella finestra Teleassistenza del programma.
SUPPORT_NAME=
SUPPORT_PHONE=
SUPPORT_EMAIL=
# Server RustDesk proprio per la teleassistenza (vuoto = server pubblico RustDesk).
RUSTDESK_SERVER=
RUSTDESK_KEY=
