@inject Api Api

<PageTitle>Accedi · Nicolò MES</PageTitle>

<div class="login">
    <form class="login-card" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <div class="brand">Nicolò MES</div>
        <h1>Accedi</h1>
        <p>Usa le stesse credenziali del programma desktop.</p>

        @if (_challenge is null)
        {
            <label>
                Email
                <input type="email" autocomplete="username" required @bind="_email" disabled="@_busy" />
            </label>
            <label>
                Password
                <input type="password" autocomplete="current-password" required @bind="_password" disabled="@_busy" />
            </label>
        }
        else
        {
            <p>Inserisci il codice di 6 cifre dell'app di autenticazione. Senza telefono puoi usare un codice di recupero.</p>
            <label>
                Codice
                <input inputmode="numeric" autocomplete="one-time-code" maxlength="12" required @bind="_code" disabled="@_busy" />
            </label>
        }

        @if (_error is not null)
        {
            <div class="alert" role="alert">@_error</div>
        }
        @if (_waking)
        {
            <div class="notice" role="status">Il server si sta avviando, attendi qualche secondo...</div>
        }

        <button type="submit" disabled="@_busy">@(_busy ? "Accesso in corso..." : _challenge is null ? "Accedi" : "Verifica")</button>
        @if (_challenge is not null)
        {
            <button type="button" class="ghost" @onclick="BackToPassword">Torna a email e password</button>
        }
        @if (_ssoVisible && _challenge is null && !_ssoOpen)
        {
            <button type="button" class="ghost sso-link" @onclick="OpenSso">Accesso aziendale (SSO)</button>
        }
    </form>

    @if (_ssoOpen)
    {
        <form class="login-card sso-card" @onsubmit="SubmitSsoAsync" @onsubmit:preventDefault>
            <h2>Accesso aziendale (SSO)</h2>
            <p class="sub">Solo sviluppo: scambio server-side con provider e subject verificati dal client OIDC.</p>
            <label>
                Provider
                <input required @bind="_ssoProvider" disabled="@_busy" placeholder="es. azure" />
            </label>
            <label>
                Subject (IdP)
                <input required @bind="_ssoSubject" disabled="@_busy" />
            </label>
            <label>
                Email
                <input type="email" required @bind="_ssoEmail" disabled="@_busy" />
            </label>
            <label>
                Nome
                <input required @bind="_ssoName" disabled="@_busy" />
            </label>
            @if (_error is not null)
            {
                <div class="alert" role="alert">@_error</div>
            }
            <button type="submit" disabled="@_busy">@(_busy ? "Accesso in corso..." : "Accedi con SSO")</button>
            <button type="button" class="ghost" @onclick="CloseSso">Annulla</button>
        </form>
    }
</div>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _code = string.Empty;
    private string? _challenge;
    private string? _error;
    private bool _busy;
    private bool _waking;
    private bool _ssoVisible;
    private bool _ssoOpen;
    private string _ssoProvider = "dev";
    private string _ssoSubject = string.Empty;
    private string _ssoEmail = string.Empty;
    private string _ssoName = string.Empty;

    protected override void OnInitialized()
    {
        // SSO link is always available; providers are loaded only when the user opens the form
        // (avoids a network call on every login page render).
        _ssoVisible = true;
    }

    private async Task OpenSso()
    {
        _error = null;
        try
        {
            var providers = await Api.GetExternalProvidersAsync();
            if (providers.Count == 0 || providers.All(p => !p.Enabled))
            {
                _error = "Accesso aziendale non configurato. Chiedi all'amministratore di abilitare Auth:External.";
                _ssoOpen = false;
                return;
            }
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _ssoOpen = false;
            return;
        }

        _ssoOpen = true;
    }

    private void CloseSso()
    {
        _ssoOpen = false;
        _error = null;
    }

    private void BackToPassword()
    {
        _challenge = null;
        _code = string.Empty;
        _error = null;
    }

    private async Task SubmitAsync()
    {
        if (_challenge is not null)
        {
            await VerifyCodeAsync();
            return;
        }

        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrEmpty(_password))
        {
            _error = "Inserisci email e password.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            // A server on a free plan may be asleep: wait for it (up to about a minute) before logging in.
            for (var attempt = 0; attempt < 8 && !await Api.IsServerUpAsync(); attempt++)
            {
                _waking = true;
                StateHasChanged();
                await Task.Delay(TimeSpan.FromSeconds(8));
            }

            _waking = false;
            var auth = await Api.LoginAsync(_email.Trim(), _password);
            _password = string.Empty;
            _challenge = auth.TwoFactorChallenge;
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
            _waking = false;
        }
    }

    private async Task VerifyCodeAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.LoginTwoFactorAsync(_challenge!, _code.Trim());
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
            if (exception.Status == System.Net.HttpStatusCode.Unauthorized && exception.Message.Contains("scaduto"))
            {
                _challenge = null;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SubmitSsoAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var auth = await Api.ExternalLoginAsync(_ssoProvider.Trim(), _ssoSubject.Trim(), _ssoEmail.Trim(), _ssoName.Trim());
            _challenge = auth.TwoFactorChallenge;
            if (_challenge is null)
            {
                _ssoOpen = false;
            }
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
