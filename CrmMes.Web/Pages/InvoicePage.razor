@page "/fatture/{Id:guid}"
@inject Api Api
@inject Session Session
@inject IJSRuntime Js

<PageTitle>@(_invoice?.Code ?? "Fattura") · Nicolò MES</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow"><a href="fatture">Fatture</a></div>
        <h1>@(_invoice is null ? "Fattura" : $"Fattura {_invoice.Code}")</h1>
        @if (_invoice is not null)
        {
            <p class="sub"><a href="clienti/@_invoice.CustomerId">@_invoice.CustomerName</a> · @Labels.InvoiceType(_invoice.DocumentType)</p>
        }
    </div>
    @if (_invoice is not null)
    {
        <span class="badge @Labels.DocumentStatusClass(_invoice.Status)">@(_invoice.Status == "Issued" ? "Emessa" : Labels.DocumentStatus(_invoice.Status))</span>
    }
</div>

@if (_error is not null)
{
    <div class="card state"><strong>Impossibile aprire la fattura</strong>@_error</div>
}
else if (_invoice is null)
{
    <div class="card state">Caricamento...</div>
}
else
{
    <div class="stack">
        @if (_invoice.Warnings.Count > 0)
        {
            <div class="notice">
                @foreach (var warning in _invoice.Warnings)
                {
                    <div>@warning</div>
                }
            </div>
        }
        @if (_invoice.Status == "Draft")
        {
            <div class="notice">Bozza: si emette dal programma desktop, che assegna il numero e controlla i dati per lo SdI.</div>
        }

        <div class="card card-pad">
            <div class="facts">
                <div class="fact"><div class="label">Numero</div><div class="value">@(_invoice.Number is null ? "—" : $"{_invoice.Number}/{_invoice.Year}")</div></div>
                <div class="fact"><div class="label">Data</div><div class="value">@Labels.Date(_invoice.IssueDate)</div></div>
                <div class="fact"><div class="label">Pagamento</div><div class="value">@_invoice.PaymentMethod</div></div>
                <div class="fact"><div class="label">Scadenza</div><div class="value">@Labels.Date(_invoice.PaymentDueDate)</div></div>
                <div class="fact"><div class="label">DDT collegati</div>
                    <div class="value">
                        @if (_invoice.TransportDocuments.Count == 0)
                        {
                            <span>—</span>
                        }
                        @foreach (var document in _invoice.TransportDocuments)
                        {
                            <a href="ddt/@document.Id" class="code">@document.DocumentCode</a><span> </span>
                        }
                    </div>
                </div>
                <div class="fact"><div class="label">Totale documento</div><div class="value">@Labels.Money(_invoice.Total)</div></div>
                @if (_invoice.Status == "Issued")
                {
                    <div class="fact"><div class="label">Stato SdI</div>
                        <div class="value"><span class="badge @Labels.SdiStatusClass(_invoice.SdiStatus)">@Labels.SdiStatus(_invoice.SdiStatus)</span>
                            @if (!string.IsNullOrWhiteSpace(_invoice.SdiTransmissionId))
                            {
                                <div class="small muted code">@_invoice.SdiTransmissionId</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_invoice.SdiMessage))
                            {
                                <div class="small muted">@_invoice.SdiMessage</div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="section-head"><h2>Righe</h2></div>
            <div class="table-wrap">
                <table class="cards">
                    <thead><tr><th>#</th><th>Descrizione</th><th class="num">Quantità</th><th class="num">Prezzo</th><th class="num">Sconto</th><th class="num">IVA</th><th class="num">Importo</th></tr></thead>
                    <tbody>
                        @foreach (var line in _invoice.Lines.OrderBy(l => l.LineNumber))
                        {
                            <tr>
                                <td data-label="#" class="muted">@line.LineNumber</td>
                                <td data-label="Descrizione">@line.Description @if (line.Code is not null) {<div class="small muted code">@line.Code</div>}</td>
                                <td data-label="Quantità" class="num">@Labels.Number(line.Quantity) @line.Unit</td>
                                <td data-label="Prezzo" class="num">@Labels.Money(line.UnitPrice)</td>
                                <td data-label="Sconto" class="num">@(line.DiscountPercent == 0 ? "—" : Labels.Number(line.DiscountPercent) + "%")</td>
                                <td data-label="IVA" class="num">@(line.VatNature ?? Labels.Number(line.VatRate) + "%")</td>
                                <td data-label="Importo" class="num">@Labels.Money(line.LineTotal)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="section-head"><h2>Riepilogo IVA</h2></div>
            <div class="table-wrap">
                <table class="cards">
                    <thead><tr><th>Aliquota</th><th class="num">Imponibile</th><th class="num">Imposta</th></tr></thead>
                    <tbody>
                        @foreach (var vat in _invoice.VatSummary)
                        {
                            <tr>
                                <td data-label="Aliquota">@(vat.Nature is null ? Labels.Number(vat.Rate) + "%" : $"Natura {vat.Nature}")</td>
                                <td data-label="Imponibile" class="num">@Labels.Money(vat.Taxable)</td>
                                <td data-label="Imposta" class="num">@Labels.Money(vat.Tax)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (_downloadError is not null)
        {
            <div class="alert" role="alert">@_downloadError</div>
        }
        @if (_sdiError is not null)
        {
            <div class="alert" role="alert">@_sdiError</div>
        }
        @if (_invoice.Status == "Issued" && !_invoice.SdiProviderConfigured)
        {
            <div class="notice">Invio automatico non configurato. Scarica l'XML, caricalo sul portale Fatture e Corrispettivi e registra qui l'esito.</div>
        }
        @if (_invoice.Status == "Issued")
        {
            <div class="actions">
                <button @onclick="DownloadXmlAsync" disabled="@_downloading">@(_downloading ? "Preparazione..." : "Scarica XML FatturaPA")</button>
                @if (CanManageSdi)
                {
                    @if (CanSubmitSdi)
                    {
                        <button class="secondary" @onclick="SubmitSdiAsync" disabled="@_sdiBusy">@(_sdiBusy ? "Invio..." : "Invia a SdI")</button>
                    }
                    @if (CanRecordManualSubmission)
                    {
                        <input class="search" type="text" maxlength="100" placeholder="Protocollo portale (facoltativo)" aria-label="Identificativo SdI" @bind="_manualSdiTransmissionId" />
                        <input class="search" type="text" maxlength="1000" placeholder="Nota esito (facoltativa)" aria-label="Nota esito SdI" @bind="_manualSdiMessage" />
                        <button class="secondary" @onclick='() => RecordSdiAsync("Submitted")' disabled="@_sdiBusy">Registra invio manuale</button>
                    }
                    @if (_invoice.SdiStatus == "Submitted")
                    {
                        <button class="secondary" @onclick='() => RecordSdiAsync("Accepted")' disabled="@_sdiBusy">Segna accettata</button>
                        <button class="secondary" @onclick='() => RecordSdiAsync("Rejected")' disabled="@_sdiBusy">Segna scartata</button>
                        <button class="secondary" @onclick='() => RecordSdiAsync("DeliveryFailed")' disabled="@_sdiBusy">Segna mancata consegna</button>
                    }
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Invoice? _invoice;
    private string? _error;
    private string? _downloadError;
    private string? _sdiError;
    private string? _manualSdiTransmissionId;
    private string? _manualSdiMessage;
    private bool _downloading;
    private bool _sdiBusy;

    private bool CanManageSdi => Session.Role is "Admin" or "Sales";

    private bool CanSubmitSdi => _invoice is { SdiProviderConfigured: true } invoice
        && invoice.SdiStatus is "NotSent" or "Rejected" or "DeliveryFailed";
    private bool CanRecordManualSubmission => _invoice?.SdiStatus is "NotSent" or "Rejected" or "DeliveryFailed";

    protected override async Task OnParametersSetAsync()
    {
        _invoice = null;
        _error = null;
        try
        {
            _invoice = await Api.GetAsync<Invoice>($"api/invoices/{Id}");
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
        }
    }

    /// <summary>The same file the desktop program saves, ready for the "Fatture e Corrispettivi" portal
    /// or an intermediary.</summary>
    private async Task DownloadXmlAsync()
    {
        _downloading = true;
        _downloadError = null;
        try
        {
            var file = await Api.GetFileAsync($"api/invoices/{Id}/xml", $"{_invoice!.Code}.xml");
            await Js.InvokeVoidAsync("nicolomes.saveFile", file.FileName, file.ContentType, Convert.ToBase64String(file.Content));
        }
        catch (ApiException exception)
        {
            _downloadError = exception.Message;
        }
        catch (JSException)
        {
            _downloadError = "Il browser non ha permesso di salvare il file.";
        }
        finally
        {
            _downloading = false;
        }
    }

    private async Task SubmitSdiAsync()
    {
        _sdiBusy = true;
        _sdiError = null;
        try
        {
            _invoice = await Api.PostAsync<Invoice>($"api/invoices/{Id}/sdi/submit");
        }
        catch (ApiException exception)
        {
            _sdiError = exception.Message;
        }
        finally
        {
            _sdiBusy = false;
        }
    }

    private async Task RecordSdiAsync(string status)
    {
        _sdiBusy = true;
        _sdiError = null;
        try
        {
            _invoice = await Api.PostAsync<Invoice>($"api/invoices/{Id}/sdi/status", new
            {
                status,
                transmissionId = string.IsNullOrWhiteSpace(_manualSdiTransmissionId) ? _invoice!.SdiTransmissionId : _manualSdiTransmissionId.Trim(),
                message = string.IsNullOrWhiteSpace(_manualSdiMessage) ? _invoice!.SdiMessage : _manualSdiMessage.Trim()
            });
            _manualSdiTransmissionId = _invoice.SdiTransmissionId;
            _manualSdiMessage = _invoice.SdiMessage;
        }
        catch (ApiException exception)
        {
            _sdiError = exception.Message;
        }
        finally
        {
            _sdiBusy = false;
        }
    }
}
