@page "/materiali"
@implements IDisposable
@inject Api Api
@inject Session Session
@inject IJSRuntime Js

<PageTitle>Materiali · Nicolò MES</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">Magazzino</div>
        <h1>Materiali</h1>
        <p class="sub">Giacenze attuali e materiali sotto la scorta minima. La ricerca mostra i primi 100 risultati.</p>
    </div>
    <div class="actions">
        @if (CanManage)
        {
            <button class="secondary" @onclick="() => _showCreate = !_showCreate">@(_showCreate ? "Chiudi nuovo materiale" : "Nuovo materiale")</button>
        }
        @if (CanImport)
        {
            <button class="secondary" @onclick="() => _showImport = !_showImport">@(_showImport ? "Chiudi importazione" : "Importa da Excel")</button>
        }
        <button class="secondary" @onclick="ExportAsync" disabled="@_exporting">@(_exporting ? "Preparazione..." : "Esporta Excel")</button>
    </div>
</div>

@if (_createError is not null)
{
    <div class="alert" role="alert">@_createError</div>
}
@if (_showCreate && CanManage)
{
    <div class="card card-pad stack stack-gap">
        <h2>Nuovo materiale</h2>
        <div class="form-grid">
            @foreach (var f in _fields.Where(f => f.Visible).OrderBy(f => f.Order))
            {
                switch (f.Key)
                {
                    case "code":
                        <label>@LabelOf(f)<input @bind="_newCode" placeholder="es. VIT-M6" autocomplete="off" /></label>
                        break;
                    case "name":
                        <label>@LabelOf(f)<input @bind="_newName" placeholder="Descrizione articolo" /></label>
                        break;
                    case "unit":
                        <label>@LabelOf(f)<input @bind="_newUnit" placeholder="pz" /></label>
                        break;
                    case "stock":
                        <label>@LabelOf(f)<input type="number" step="any" min="0" @bind="_newStock" /></label>
                        break;
                    case "minStock":
                        <label>@LabelOf(f)<input type="number" step="any" min="0" @bind="_newMinStock" /></label>
                        break;
                }
            }
            @foreach (var f in _customFields.OrderBy(f => f.Order))
            {
                <label>@(f.Required ? f.Label + " *" : f.Label)
                    @switch (f.FieldType)
                    {
                        case "Number":
                            <input type="number" step="any" aria-label="@f.Label" value="@CustomFieldValue(f.Key)" @oninput="e => SetCustomField(f.Key, e.Value?.ToString())" />
                            break;
                        case "Date":
                            <input type="date" aria-label="@f.Label" value="@CustomFieldValue(f.Key)" @oninput="e => SetCustomField(f.Key, e.Value?.ToString())" />
                            break;
                        case "Checkbox":
                            <input type="checkbox" aria-label="@f.Label" checked="@CustomFieldChecked(f.Key)" @onchange="e => SetCustomFieldChecked(f.Key, e.Value)" />
                            break;
                        default:
                            <input aria-label="@f.Label" value="@CustomFieldValue(f.Key)" @oninput="e => SetCustomField(f.Key, e.Value?.ToString())" />
                            break;
                    }
                </label>
            }
        </div>
        <div class="actions"><button @onclick="CreateAsync" disabled="@_creating">@(_creating ? "Salvataggio..." : "Crea materiale")</button></div>
    </div>
}

@if (_exportError is not null)
{
    <div class="alert" role="alert">@_exportError</div>
}
@if (_showImport)
{
    <div class="stack-gap"><ArticleImport Imported="LoadAsync" /></div>
}

<div class="toolbar">
    <input class="search" type="search" placeholder="Codice o descrizione" aria-label="Cerca materiale" value="@_search" @oninput="OnSearchInput" />
    <label class="check"><input type="checkbox" checked="@_belowOnly" @onchange="ToggleBelowAsync" /> Solo sotto scorta</label>
</div>

<div class="card">
    @if (_error is not null)
    {
        <div class="state"><strong>Impossibile caricare i materiali</strong>@_error
            <div class="actions"><button class="secondary small" @onclick="LoadAsync">Riprova</button></div></div>
    }
    else if (_materials is null)
    {
        <div class="state">Caricamento...</div>
    }
    else if (_materials.Count == 0)
    {
        <div class="state"><strong>Nessun materiale</strong>@(_belowOnly
            ? "Nessun materiale sotto scorta."
            : string.IsNullOrWhiteSpace(_search) && CanManage
                ? "Aggiungi il primo materiale con «Nuovo materiale» o importa da Excel."
                : "Nessun materiale corrisponde alla ricerca.")</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="cards">
                <thead><tr><th>Codice</th><th>Descrizione</th><th class="num">Giacenza</th><th class="num">Scorta minima</th><th class="num">Prezzo</th><th>Stato</th></tr></thead>
                <tbody>
                    @foreach (var material in _materials)
                    {
                        <tr>
                            <td data-label="Codice"><CopyCode Value="@material.Code" /></td>
                            <td data-label="Descrizione">@material.Name</td>
                            <td data-label="Giacenza" class="num">@Labels.Number(material.Stock) @material.Unit</td>
                            <td data-label="Scorta minima" class="num muted">@Labels.Number(material.MinStock) @material.Unit</td>
                            <td data-label="Prezzo" class="num">@(material.ListPrice is null ? "—" : Labels.Money(material.ListPrice.Value))</td>
                            <td data-label="Stato">
                                @if (material.BelowMinimum)
                                {
                                    <span class="badge warn">Sotto scorta</span>
                                }
                                else
                                {
                                    <span class="badge ok">Disponibile</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private string _search = string.Empty;
    private bool _belowOnly;
    private List<Material>? _materials;
    private string? _error;
    private CancellationTokenSource? _debounce;
    private bool _showImport;
    private bool _showCreate;
    private bool _exporting;
    private bool _creating;
    private string? _exportError;
    private string? _createError;
    private string _newCode = string.Empty;
    private string _newName = string.Empty;
    private string _newUnit = "pz";
    private decimal _newStock;
    private decimal _newMinStock;
    private List<CustomFieldDefinition> _customFields = [];
    private readonly Dictionary<string, string?> _customFieldValues = [];

    private string? CustomFieldValue(string key) => _customFieldValues.GetValueOrDefault(key);
    private void SetCustomField(string key, string? value) => _customFieldValues[key] = value;
    private bool CustomFieldChecked(string key) => bool.TryParse(_customFieldValues.GetValueOrDefault(key), out var value) && value;
    private void SetCustomFieldChecked(string key, object? value) => _customFieldValues[key] = value is true ? bool.TrueString : bool.FalseString;

    private bool CanImport => Session.Role is "Admin" or "Warehouse" or "Purchasing";
    private bool CanManage => CanImport;

    /// <summary>Campi del modulo Nuovo materiale come li ha impostati l'Admin nello strumento Layout.</summary>
    private List<LayoutField> _fields =
    [
        new("code", "Codice", 1, true, true, false),
        new("name", "Descrizione", 2, true, true, false),
        new("unit", "Unità di misura", 3, true, false, true),
        new("stock", "Giacenza iniziale", 4, true, false, true),
        new("minStock", "Scorta minima", 5, true, false, true),
    ];

    private static string LabelOf(LayoutField f) => f.Required ? f.Label + " *" : f.Label;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await LoadCreateLayoutAsync();
    }

    private async Task LoadCreateLayoutAsync()
    {
        try
        {
            _fields = (await Api.GetAsync<LayoutScreen>("api/layout/materials.new")).Fields;
        }
        catch (ApiException)
        {
            // Restano i default: il layout non deve impedire di creare materiali.
        }

        try
        {
            _customFields = await Api.GetAsync<List<CustomFieldDefinition>>("api/layout/materials.new/custom-fields");
        }
        catch (ApiException)
        {
            // Nessun campo personalizzato, o non raggiungibile: il modulo resta con i soli campi standard.
        }
    }

    private async Task ExportAsync()
    {
        _exporting = true;
        _exportError = null;
        try
        {
            var file = await Api.GetFileAsync("api/materials/export", $"articoli-{DateTime.Now:yyyyMMdd}.xlsx");
            await Js.InvokeVoidAsync("nicolomes.saveFile", file.FileName, file.ContentType, Convert.ToBase64String(file.Content));
        }
        catch (ApiException exception)
        {
            _exportError = exception.Message;
        }
        catch (JSException)
        {
            _exportError = "Il browser non ha permesso di salvare il file.";
        }
        finally
        {
            _exporting = false;
        }
    }

    private async Task ToggleBelowAsync(ChangeEventArgs e)
    {
        _belowOnly = e.Value is true;
        await LoadAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, _debounce.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _materials = null;
        try
        {
            var query = $"api/materials?belowMinimumOnly={(_belowOnly ? "true" : "false")}";
            if (!string.IsNullOrWhiteSpace(_search))
            {
                query += "&q=" + Uri.EscapeDataString(_search.Trim());
            }

            _materials = await Api.GetAsync<List<Material>>(query);
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
        }
    }

    private async Task CreateAsync()
    {
        var missing = _fields.Where(f => f.Visible && f.Required && string.IsNullOrWhiteSpace(f.Key switch
            {
                "code" => _newCode,
                "name" => _newName,
                "unit" => _newUnit,
                // Giacenza e scorta minima sono numeriche con valore sempre presente (0 di default):
                // "obbligatorio" per loro non ha un vuoto da intercettare qui.
                "stock" or "minStock" => "0",
                _ => null,
            })).Select(LabelOf).ToList();
        missing.AddRange(_customFields.Where(f => f.Required && string.IsNullOrWhiteSpace(CustomFieldValue(f.Key))).Select(f => f.Label));
        if (missing.Count > 0)
        {
            _createError = "Compila i campi obbligatori: " + string.Join(", ", missing) + ".";
            return;
        }

        _creating = true;
        _createError = null;
        try
        {
            await Api.PostAsync<Material>("api/materials", new
            {
                code = _newCode.Trim(),
                name = _newName.Trim(),
                unit = string.IsNullOrWhiteSpace(_newUnit) ? "pz" : _newUnit.Trim(),
                stock = _newStock,
                minStock = _newMinStock,
                customFields = _customFieldValues,
            });
            _newCode = string.Empty;
            _newName = string.Empty;
            _newUnit = "pz";
            _newStock = 0;
            _newMinStock = 0;
            _customFieldValues.Clear();
            _showCreate = false;
            await LoadAsync();
        }
        catch (ApiException exception)
        {
            _createError = exception.Message;
        }
        finally
        {
            _creating = false;
        }
    }

    public void Dispose() => _debounce?.Cancel();
}
