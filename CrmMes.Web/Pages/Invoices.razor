@page "/fatture"
@inject Api Api
@inject Session Session
@inject NavigationManager Nav

<PageTitle>Fatture · Nicolò MES</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">Documenti</div>
        <h1>Fatture</h1>
        <p class="sub">Fatture elettroniche, con il file XML da inviare allo SdI.</p>
    </div>
</div>

@if (!CanSee)
{
    <div class="card state"><strong>Non disponibile per il tuo ruolo</strong>Le fatture sono visibili ad amministrazione, direzione e commerciale.</div>
}
else
{
    <div class="toolbar">
        <input class="search" type="search" placeholder="Numero o cliente" aria-label="Filtra fatture" @bind="_search" @bind:event="oninput" />
        <div class="chips" role="group" aria-label="Stato">
            @foreach (var (key, label) in Filters)
            {
                <button class="chip @(_status == key ? "active" : "")" aria-pressed="@(_status == key)" @onclick="() => ChangeStatusAsync(key)">@label</button>
            }
        </div>
    </div>

    <div class="card">
        @if (_error is not null)
        {
            <div class="state"><strong>Impossibile caricare le fatture</strong>@_error
                <div class="actions"><button class="secondary small" @onclick="LoadAsync">Riprova</button></div></div>
        }
        else if (_invoices is null)
        {
            <div class="state">Caricamento...</div>
        }
        else if (Visible.Count == 0)
        {
            <div class="state"><strong>Nessuna fattura</strong>@(string.IsNullOrWhiteSpace(_search) ? "Nessuna fattura in questo stato." : $"Nessuna fattura corrisponde a \"{_search}\".")</div>
        }
        else
        {
            <div class="table-wrap">
                <table class="cards">
                    <thead><tr><th>Fattura</th><th>Tipo</th><th>Cliente</th><th>Data</th><th class="num">Totale</th><th>Stato</th></tr></thead>
                    <tbody>
                        @foreach (var invoice in Visible)
                        {
                            <tr class="link" @onclick="@(() => Nav.NavigateTo($"fatture/{invoice.Id}"))">
                                <td data-label="Fattura"><CopyCode Value="@invoice.Code" /></td>
                                <td data-label="Tipo" class="muted">@Labels.InvoiceType(invoice.DocumentType)</td>
                                <td data-label="Cliente">@invoice.CustomerName</td>
                                <td data-label="Data">@Labels.Date(invoice.IssueDate)</td>
                                <td data-label="Totale" class="num">@Labels.Money(invoice.Total)</td>
                                <td data-label="Stato"><span class="badge @Labels.DocumentStatusClass(invoice.Status)">@(invoice.Status == "Issued" ? "Emessa" : Labels.DocumentStatus(invoice.Status))</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="section-head small muted">
                <span>@Visible.Count fatture</span>
                <span>Totale @Labels.Money(Visible.Sum(i => i.Total))</span>
            </div>
        }
    </div>
}

@code {
    private static readonly (string Key, string Label)[] Filters = [("", "Tutte"), ("Draft", "Bozze"), ("Issued", "Emesse")];

    private string _status = string.Empty;
    private string _search = string.Empty;
    private List<InvoiceSummary>? _invoices;
    private string? _error;

    private bool CanSee => Session.Role is "Admin" or "Sales" or "Management";

    private List<InvoiceSummary> Visible => (_invoices ?? [])
        .Where(i => string.IsNullOrWhiteSpace(_search)
            || i.Code.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || i.CustomerName.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(i => i.IssueDate ?? i.CreatedAt)
        .ToList();

    protected override Task OnInitializedAsync() => CanSee ? LoadAsync() : Task.CompletedTask;

    private async Task ChangeStatusAsync(string status)
    {
        _status = status;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _invoices = null;
        try
        {
            _invoices = await Api.GetAsync<List<InvoiceSummary>>(_status.Length == 0 ? "api/invoices" : $"api/invoices?status={_status}");
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
        }
    }
}
