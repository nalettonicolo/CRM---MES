@page "/preventivi/{Id:guid}"
@inject Api Api
@inject Session Session

<PageTitle>@(_quote?.Code ?? "Preventivo") · Nicolò MES</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow"><a href="preventivi">Preventivi</a></div>
        <h1>@(_quote is null ? "Preventivo" : $"Preventivo {_quote.Code}")</h1>
        @if (_quote is not null)
        {
            <p class="sub"><a href="clienti/@_quote.CustomerId">@_quote.CustomerName</a></p>
        }
    </div>
    @if (_quote is not null)
    {
        <span class="badge @Labels.QuoteStatusClass(_quote.Status, _quote.ConvertedAt)">@Labels.QuoteStatus(_quote.Status, _quote.ConvertedAt)</span>
    }
</div>

@if (_error is not null)
{
    <div class="card state"><strong>Impossibile aprire il preventivo</strong>@_error</div>
}
else if (_quote is null)
{
    <div class="card state">Caricamento...</div>
}
else
{
    <div class="stack">
        @if (QuoteRules.IsExpired(_quote, DateTime.UtcNow))
        {
            <div class="notice">Validità scaduta il @Labels.Date(_quote.ValidUntil): verifica i prezzi prima di confermarlo.</div>
        }

        <div class="card card-pad">
            <div class="facts">
                <div class="fact"><div class="label">Codice</div><div class="value"><CopyCode Value="@_quote.Code" /></div></div>
                <div class="fact"><div class="label">Creato</div><div class="value">@Labels.Date(_quote.CreatedAt)</div></div>
                <div class="fact"><div class="label">Valido fino al</div><div class="value">@Labels.Date(_quote.ValidUntil)</div></div>
                <div class="fact"><div class="label">Inviato</div><div class="value">@Labels.DateTime(_quote.SentAt)</div></div>
                <div class="fact"><div class="label">@(_quote.RejectedAt is null ? "Accettato" : "Rifiutato")</div><div class="value">@Labels.DateTime(_quote.RejectedAt ?? _quote.AcceptedAt)</div></div>
                <div class="fact"><div class="label">Convertito in commessa</div><div class="value">@Labels.DateTime(_quote.ConvertedAt)</div></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_quote.Notes))
            {
                <p class="muted small">@_quote.Notes</p>
            }
        </div>

        <div class="card">
            <div class="section-head"><h2>Righe</h2><strong>Totale @Labels.Money(_quote.Total)</strong></div>
            @if (_quote.Items.Count == 0)
            {
                <div class="state">Nessuna riga: il preventivo è vuoto.</div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="cards">
                        <thead><tr><th>#</th><th>Descrizione</th><th class="num">Quantità</th><th class="num">Prezzo</th><th class="num">Sconto</th><th class="num">Importo</th></tr></thead>
                        <tbody>
                            @foreach (var item in _quote.Items.OrderBy(i => i.SequenceNumber))
                            {
                                <tr>
                                    <td data-label="#" class="muted">@item.SequenceNumber</td>
                                    <td data-label="Descrizione">
                                        @item.Description
                                        @if (item.ProductCode is not null)
                                        {
                                            <div class="small muted code">@item.ProductCode</div>
                                        }
                                    </td>
                                    <td data-label="Quantità" class="num">@Labels.Number(item.Quantity)</td>
                                    <td data-label="Prezzo" class="num">@Labels.Money(item.UnitPrice)</td>
                                    <td data-label="Sconto" class="num">@(item.DiscountPercent == 0 ? "—" : Labels.Number(item.DiscountPercent) + "%")</td>
                                    <td data-label="Importo" class="num">@Labels.Money(item.LineTotal)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @if ((_quote.WorkOrders?.Count ?? 0) > 0)
        {
            <div class="card">
                <div class="section-head"><h2>Commesse da questo preventivo</h2></div>
                <div class="chips">
                    @foreach (var order in _quote.WorkOrders!)
                    {
                        <a href="commesse/@order.Id" class="code">@order.Code</a>
                    }
                </div>
                <p class="small muted">Apri ogni commessa, assegna l'area se manca, poi genera la distinta di prelievo.</p>
            </div>
        }

        @if (_converted is { Count: > 0 } && (_quote.WorkOrders is null || _quote.WorkOrders.Count == 0))
        {
            <div class="success" role="status">
                Commesse create:
                @foreach (var order in _converted)
                {
                    <a href="commesse/@order.Id" class="code">@order.Code</a><span> </span>
                }
            </div>
        }
        @if (_actionError is not null)
        {
            <div class="alert" role="alert">@_actionError</div>
        }

        @if (_confirm is not null)
        {
            <div class="card card-pad">
                <h2>@_confirm.Title</h2>
                <p class="muted">@_confirm.Message</p>
                @if (_confirm.IsConvert)
                {
                    <div class="facts">
                        @if (Shows("area"))
                        {
                        <div class="fact">
                            <div class="label">@LabelFor("area", "Area di produzione")</div>
                            <div class="value">
                                <select @bind="_convertAreaId">
                                    <option value="">Scegli area (consigliato)</option>
                                    @foreach (var area in _areas ?? [])
                                    {
                                        <option value="@area.Id">@area.Name (@area.Code)</option>
                                    }
                                </select>
                            </div>
                        </div>
                        }
                        @if (Shows("dueDate"))
                        {
                        <div class="fact">
                            <div class="label">@LabelFor("dueDate", "Consegna prevista")</div>
                            <div class="value"><input type="date" @bind="_convertDueDate" /></div>
                        </div>
                        }
                    </div>
                    @if (_areas is { Count: 0 })
                    {
                        <p class="small muted">Nessuna area attiva: le commesse nascono senza area; potrai assegnarla dopo.</p>
                    }
                }
                <div class="actions">
                    <button class="secondary" @onclick="() => _confirm = null" disabled="@_busy">Annulla</button>
                    <button @onclick="_confirm.Run" disabled="@_busy">@(_busy ? "Attendere..." : _confirm.Title)</button>
                </div>
            </div>
        }
        else if (HasActions)
        {
            <div class="actions">
                @if (QuoteRules.CanDecide(_quote, Role))
                {
                    <button class="secondary" @onclick="AskReject">Rifiutato dal cliente</button>
                }
                @if (QuoteRules.CanSend(_quote, Role))
                {
                    <button class="secondary" @onclick="SendAsync" disabled="@_busy">Segna come inviato</button>
                }
                @if (QuoteRules.CanDecide(_quote, Role))
                {
                    <button @onclick="AskAccept">Accettato dal cliente</button>
                }
                @if (QuoteRules.CanTurnIntoWorkOrders(_quote, Role))
                {
                    <button @onclick="AskConvertAsync">Crea le commesse</button>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private sealed record Confirmation(string Title, string Message, Func<Task> Run, bool IsConvert = false);

    private Quote? _quote;
    private string? _error;
    private string? _actionError;
    private Confirmation? _confirm;
    private List<ConvertedWorkOrder>? _converted;
    private List<AreaRow>? _areas;
    private LayoutScreen? _convertLayout;
    private string _convertAreaId = "";
    private DateTime? _convertDueDate;
    private bool _busy;

    private string Role => Session.Role;

    private bool HasActions => _quote is not null
        && (QuoteRules.CanSend(_quote, Role) || QuoteRules.CanDecide(_quote, Role) || QuoteRules.CanTurnIntoWorkOrders(_quote, Role));

    protected override async Task OnParametersSetAsync()
    {
        _quote = null;
        _error = null;
        _converted = null;
        try
        {
            _quote = await Api.GetAsync<Quote>($"api/quotes/{Id}");
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
        }
    }

    private Task SendAsync() => RunAsync(async () => _quote = await Api.PostAsync<Quote>($"api/quotes/{Id}/send"));

    private void AskAccept() => _confirm = new("Accettato dal cliente",
        "Il preventivo diventa definitivo: non si potrà più modificare e si potranno creare le commesse.",
        () => RunAsync(async () => _quote = await Api.PostAsync<Quote>($"api/quotes/{Id}/accept")));

    private void AskReject() => _confirm = new("Rifiutato dal cliente",
        "Il preventivo resta in archivio come rifiutato e non si potrà più accettare.",
        () => RunAsync(async () => _quote = await Api.PostAsync<Quote>($"api/quotes/{Id}/reject")));

    /// <summary>Layout della conversione: area e consegna con etichette e obbligatorietà dell'Admin. Se non
    /// arriva, il form resta con i valori di default.</summary>
    private LayoutField? FieldOf(string key) => _convertLayout?.Fields.FirstOrDefault(f => f.Key == key);

    private bool Shows(string key) => FieldOf(key) is not { Visible: false };

    private string LabelFor(string key, string fallback) => FieldOf(key) is { } field ? LayoutHelper.LabelOf(field) : fallback;

    private async Task AskConvertAsync()
    {
        _actionError = null;
        try
        {
            try { _convertLayout ??= await Api.GetAsync<LayoutScreen>("api/layout/quote.convert"); }
            catch (ApiException) { _convertLayout = null; }
            _areas ??= await Api.GetAsync<List<AreaRow>>("api/areas");
            if (string.IsNullOrEmpty(_convertAreaId) && _areas is { Count: 1 })
            {
                _convertAreaId = _areas[0].Id.ToString();
            }
        }
        catch (ApiException exception)
        {
            _actionError = exception.Message;
            return;
        }

        _confirm = new("Crea le commesse",
            $"Viene creata una commessa in bozza per ogni riga con un prodotto ({_quote!.Items.Count(i => i.ProductId is not null)}). L'area consente subito la distinta di prelievo. Le righe descrittive restano solo nel preventivo.",
            () => RunAsync(async () =>
            {
                if (_convertLayout is not null)
                {
                    var missing = LayoutHelper.Missing(_convertLayout.Fields, key => key switch
                    {
                        "area" => _convertAreaId,
                        "dueDate" => _convertDueDate?.ToString("yyyy-MM-dd"),
                        _ => null,
                    });
                    if (missing.Count > 0)
                    {
                        throw new ApiException("Compila i campi obbligatori: " + string.Join(", ", missing) + ".");
                    }
                }

                Guid? areaId = Guid.TryParse(_convertAreaId, out var parsed) ? parsed : null;
                var result = await Api.PostAsync<ConvertQuoteResult>($"api/quotes/{Id}/convert",
                    new { dueDate = _convertDueDate, areaId });
                _converted = result.WorkOrders;
                _quote = await Api.GetAsync<Quote>($"api/quotes/{Id}");
            }),
            IsConvert: true);
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _actionError = null;
        try
        {
            await action();
            _confirm = null;
        }
        catch (ApiException exception)
        {
            _actionError = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
