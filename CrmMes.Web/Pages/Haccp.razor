@page "/haccp"
@inject Api Api
@inject Session Session

<PageTitle>HACCP · Nicolò MES</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">Qualità</div>
        <h1>HACCP</h1>
        <p class="sub">Punti di controllo e ultime letture. Fuori limite serve l'azione correttiva.</p>
    </div>
</div>

@if (_templates is { Count: > 0 })
{
    <div class="card">
        <div class="section-head"><h2>Modelli per tipologia</h2></div>
        <p class="sub">Punti di controllo tipici del processo. Si aggiungono al registro; quelli già presenti non vengono duplicati. I limiti si adattano poi dal programma desktop.</p>
        @if (_notice is not null)
        {
            <div class="notice" role="status">@_notice</div>
        }
        @if (_applyError is not null)
        {
            <div class="notice" role="alert"><strong>Modello non applicato.</strong> @_applyError</div>
        }
        <div class="table-wrap">
            <table class="cards">
                <thead><tr><th>Tipologia</th><th>Punti</th><th>Azione</th></tr></thead>
                <tbody>
                    @foreach (var template in _templates)
                    {
                        <tr>
                            <td data-label="Tipologia">@template.Name <div class="small muted">@template.Description</div></td>
                            <td data-label="Punti">@template.Points.Count</td>
                            <td data-label="Azione">
                                @if (!CanApply)
                                {
                                    <span class="muted">Solo magazzino e amministrazione</span>
                                }
                                else if (_pendingKey == template.Key)
                                {
                                    <span>Aggiungo il modello al registro? </span>
                                    <button class="small" disabled="@_applying" @onclick="() => ApplyAsync(template.Key)">Conferma</button>
                                    <button class="secondary small" disabled="@_applying" @onclick="() => _pendingKey = null">Annulla</button>
                                }
                                else
                                {
                                    <button class="secondary small" disabled="@_applying" @onclick="() => _pendingKey = template.Key">Applica</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (_error is not null)
{
    <div class="card state"><strong>@Labels.LoadFailed("i registri HACCP")</strong>@_error
        <div class="actions"><button class="secondary small" @onclick="LoadAsync">@Labels.Retry</button></div></div>
}
else if (_points is null)
{
    <div class="card state">@Labels.Loading</div>
}
else if (_points.Count == 0)
{
    <div class="card state"><strong>Nessun punto di controllo</strong>Applica un modello qui sopra oppure definisci i punti dal programma desktop.</div>
}
else
{
    <div class="stack">
        <div class="card">
            <div class="table-wrap">
                <table class="cards">
                    <thead><tr><th>Punto</th><th>Luogo</th><th>Ultima lettura</th><th>Esito</th></tr></thead>
                    <tbody>
                        @foreach (var point in _points)
                        {
                            <tr>
                                <td data-label="Punto">@point.Name <div class="small muted">@(point.Hazard ?? point.Frequency)</div></td>
                                <td data-label="Luogo">@(point.Location ?? "—")</td>
                                <td data-label="Ultima lettura">@Labels.DateTime(point.LastReadAt) @if (point.LastValue is not null) {<span> · @Labels.Number(point.LastValue.Value) @(point.Unit)</span>}</td>
                                <td data-label="Esito">
                                    @if (point.LastCompliant is true) {<span class="badge ok">Conforme</span>}
                                    else if (point.LastCompliant is false) {<span class="badge danger">Non conforme</span>}
                                    else {<span class="muted">—</span>}
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (_readings is { Count: > 0 })
        {
            <div class="card">
                <div class="section-head"><h2>Letture degli ultimi 14 giorni</h2></div>
                <div class="table-wrap">
                    <table class="cards">
                        <thead><tr><th>Quando</th><th>Punto</th><th>Valore</th><th>Esito</th></tr></thead>
                        <tbody>
                            @foreach (var reading in _readings)
                            {
                                <tr>
                                    <td data-label="Quando">@Labels.DateTime(reading.ReadAt)</td>
                                    <td data-label="Punto">@reading.ControlPointName</td>
                                    <td data-label="Valore">@(reading.Value is null ? (reading.Compliant ? "OK" : "KO") : Labels.Number(reading.Value.Value))</td>
                                    <td data-label="Esito">
                                        @if (reading.Compliant) {<span class="badge ok">Conforme</span>}
                                        else {<span class="badge danger">Azione: @(reading.CorrectiveAction ?? "—")</span>}
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<HaccpControlPoint>? _points;
    private List<HaccpReading>? _readings;
    private List<HaccpTemplate>? _templates;
    private string? _pendingKey;
    private string? _notice;
    private string? _applyError;
    private bool _applying;
    private string? _error;

    private bool CanApply => Session.Role is "Admin" or "Warehouse";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _templates = await Api.GetAsync<List<HaccpTemplate>>("api/haccp/templates");
            _points = await Api.GetAsync<List<HaccpControlPoint>>("api/haccp/control-points");
            var from = DateTime.UtcNow.Date.AddDays(-14).ToString("yyyy-MM-dd");
            var to = DateTime.UtcNow.Date.ToString("yyyy-MM-dd");
            _readings = await Api.GetAsync<List<HaccpReading>>($"api/haccp/readings?from={from}&to={to}");
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
        }
    }

    private async Task ApplyAsync(string key)
    {
        _applying = true;
        _notice = null;
        _applyError = null;
        try
        {
            var result = await Api.PostAsync<ApplyHaccpTemplateResult>($"api/haccp/templates/{key}/apply");
            _notice = $"Modello applicato: aggiunti {result.Created}, già presenti {result.Skipped}.";
            _pendingKey = null;
            await LoadAsync();
        }
        catch (ApiException exception)
        {
            _applyError = exception.Message;
        }
        finally
        {
            _applying = false;
        }
    }
}
