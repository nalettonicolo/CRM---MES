@page "/ddt"
@implements IDisposable
@inject Api Api
@inject NavigationManager Nav

<PageTitle>Documenti di trasporto · Nicolò MES</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">Documenti</div>
        <h1>Documenti di trasporto</h1>
        <p class="sub">Vendite, conto lavoro, resi e altre uscite di merce.</p>
    </div>
</div>

<div class="toolbar">
    <input class="search" type="search" placeholder="Numero, destinatario o codice" aria-label="Cerca DDT" value="@_search" @oninput="OnSearchInput" />
    <div class="chips" role="group" aria-label="Stato">
        @foreach (var (key, label) in Filters)
        {
            <button class="chip @(_status == key ? "active" : "")" aria-pressed="@(_status == key)" @onclick="() => ChangeStatusAsync(key)">@label</button>
        }
    </div>
</div>

<div class="card">
    @if (_error is not null)
    {
        <div class="state"><strong>Impossibile caricare i documenti</strong>@_error
            <div class="actions"><button class="secondary small" @onclick="LoadAsync">Riprova</button></div></div>
    }
    else if (_documents is null)
    {
        <div class="state">Caricamento...</div>
    }
    else if (_documents.Count == 0)
    {
        <div class="state"><strong>Nessun documento</strong>@(string.IsNullOrWhiteSpace(_search) ? "Nessun documento di trasporto in questo stato." : $"Nessun documento corrisponde a \"{_search}\".")</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="cards">
                <thead><tr><th>Documento</th><th>Causale</th><th>Destinatario</th><th>Emesso</th><th class="num">Righe</th><th>Stato</th></tr></thead>
                <tbody>
                    @foreach (var document in _documents)
                    {
                        <tr class="link" @onclick="@(() => Nav.NavigateTo($"ddt/{document.Id}"))">
                            <td data-label="Documento"><CopyCode Value="@document.DocumentCode" /></td>
                            <td data-label="Causale">@document.ReasonLabel</td>
                            <td data-label="Destinatario">@document.RecipientName</td>
                            <td data-label="Emesso">@Labels.Date(document.IssuedAt)</td>
                            <td data-label="Righe" class="num">@document.LineCount</td>
                            <td data-label="Stato"><span class="badge @Labels.DocumentStatusClass(document.Status)">@Labels.DocumentStatus(document.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private static readonly (string Key, string Label)[] Filters =
    [
        ("", "Tutti"), ("Draft", "Bozze"), ("Issued", "Emessi"), ("Cancelled", "Annullati"),
    ];

    private string _status = string.Empty;
    private string _search = string.Empty;
    private List<TransportDocumentSummary>? _documents;
    private string? _error;
    private CancellationTokenSource? _debounce;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task ChangeStatusAsync(string status)
    {
        _status = status;
        await LoadAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, _debounce.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _documents = null;
        try
        {
            var query = new List<string>();
            if (_status.Length > 0) query.Add("status=" + _status);
            if (!string.IsNullOrWhiteSpace(_search)) query.Add("search=" + Uri.EscapeDataString(_search.Trim()));
            _documents = await Api.GetAsync<List<TransportDocumentSummary>>("api/transport-documents" + (query.Count > 0 ? "?" + string.Join('&', query) : string.Empty));
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
        }
    }

    public void Dispose() => _debounce?.Cancel();
}
